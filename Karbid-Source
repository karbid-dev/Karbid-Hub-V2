function Window:_RenderSearch(text)
    text = Trim(text)

    if text == "" then
        if self._searching then
            self._searching = false
            self:_ClearResults()
            self.SearchEmpty.Visible = false
            self.SearchPage.Visible = false

            if self.ActiveTab then
                self.ActiveTab.Page.Visible = true
            end
        end

        return
    end

    if not self._searching then
        self._searching = true

        if self._popup then
            self._popup:Close()
        end

        if self.ActiveTab then
            self.ActiveTab.Page.Visible = false
        end

        self.SearchPage.Visible = true
    end

    self:_ClearResults()

    local results = self:Search(text)

    for index, element in ipairs(results) do
        self._searchRows[index] = self:_SearchRow(element, index)
    end

    self.SearchEmpty.Visible = #results == 0
end

-- Opens the tab that holds `element`, expands its section, scrolls to it and
-- pulses it.
function Window:_GoTo(element)
    if element.Destroyed then
        return
    end

    local section = element.Section
    local tab = section.Tab

    self:ClearSearch()
    tab:Select()

    if section.Collapsed then
        section:SetCollapsed(false, true)
    end

    -- The layout needs a moment to settle before positions can be read.
    task.delay(0.05, function()
        if self.Destroyed or element.Destroyed then
            return
        end

        -- The section sits in one of the tab's scrolling columns.
        local column = section.Frame.Parent
        local offset = element.Card.AbsolutePosition.Y - column.AbsolutePosition.Y + column.CanvasPosition.Y - 12

        column.CanvasPosition = Vector2.new(0, math.max(0, offset))
        element:_Pulse()
    end)
end

-- Empties the search box and brings the tab page back.
function Window:ClearSearch()
    self._searchToken = self._searchToken + 1

    if self.SearchBox then
        self.SearchBox.Text = ""
        self:_RenderSearch("")
    end
end

function Window:SetTitle(title)
    self.Title = title
    self.TitleLabel.Text = title
end

function Window:SetSubtitle(text)
    self.SubtitleLabel.Text = text
    self.SubtitleLabel.Visible = text ~= ""
end

function Window:SetMinimized(minimized)
    if minimized == self.Minimized then
        return
    end

    self.Minimized = minimized
    self._minimizeToken = self._minimizeToken + 1
    local token = self._minimizeToken
    local full = self._fullSize

    self:_TooltipHide()

    if self.ResizeHandle then
        self.ResizeHandle.Visible = not minimized
    end

    SetShadowStyle(self.Shadow, minimized and "Compact" or "Window")
    SetControlIcon(self.MinimizeButton, minimized and "maximize-2" or "minimize-2", minimized and "□" or "–")

    if minimized then
        Tween(self.Main, "Hover", { Size = UDim2.new(full.X.Scale, full.X.Offset, 0, Metrics.TopBarHeight) })

        task.delay(0.3, function()
            if token == self._minimizeToken and self.Minimized then
                self.Body.Visible = false
            end
        end)
    else
        self.Body.Visible = true
        Tween(self.Main, "Hover", { Size = full })
    end
end

-- The window fills the screen (a small margin stays), or goes back to its old
-- size and place. The resize handle and dragging are off while it is full.
function Window:SetFullscreen(on)
    on = on and true or false

    if on == self.Fullscreen or self.Destroyed then
        return
    end

    if self.Minimized then
        self:SetMinimized(false)
    end

    self.Fullscreen = on
    self:_TooltipHide()

    local main = self.Main

    if on then
        -- The margin is measured from the top of the screen, wherever the gui starts.
        local origin = GuiOrigin(self.Gui)

        self._windowedSize = self._fullSize
        self._windowedPosition = main.Position
        self._fullSize = UDim2.new(1, -FULLSCREEN_MARGIN * 2, 1, origin - FULLSCREEN_MARGIN * 2)

        Tween(main, "Hover", {
            Size = self._fullSize,
            Position = UDim2.new(0.5, 0, 0, FULLSCREEN_MARGIN - origin),
        })
    else
        self._fullSize = self._windowedSize
        Tween(main, "Hover", { Size = self._fullSize, Position = self._windowedPosition })
    end

    if self.ResizeHandle then
        self.ResizeHandle.Visible = not on
    end

    SetControlIcon(self.FullscreenButton, on and "shrink" or "expand", on and "▣" or "▢")
    SetControlActive(self.FullscreenButton, on)
end

-- A see-through window: the background and the top bar become a little
-- transparent, the elements stay as they are.
function Window:SetTransparent(on)
    on = on and true or false

    if on == self.Transparent or self.Destroyed then
        return
    end

    self.Transparent = on

    local amount = on and TRANSPARENT_AMOUNT or 0

    Tween(self.Surface, "Hover", { BackgroundTransparency = amount })
    Tween(self.Bar, "Hover", { BackgroundTransparency = amount })
    SetControlActive(self.TransparencyButton, on)
end

-- Pop-out panels ------------------------------------------------------------
--
-- Section:PopOut() lifts one section (Configuration, Interface, About...) out
-- of its tab into a floating panel. The panel lives in its own gui, so it stays
-- on screen when the window is hidden. Its top bar has a collapse button
-- (hides / shows the elements) and a restore button. The tab keeps a small
-- placeholder with a restore button where the section used to be.

local PANEL_WIDTH = 340
local PANEL_MAX_HEIGHT = 480
local PANEL_BAR = 34
local PANEL_MIN = Vector2.new(260, 120)
local PANEL_PADDING = 10

function Window:_PanelGui()
    if self.PanelGui then
        return self.PanelGui
    end

    local gui = Create("ScreenGui", {
        Name = LIBRARY_NAME .. "Panels",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 1000, -- above the window (999)
    })

    ProtectGui(gui)
    Library:Track(gui)
    AddOriginProbe(gui)
    gui.Parent = Env.GetGuiParent()

    self.PanelGui = gui
    return gui
end

-- The small button in the section header that pops the section out.
function Section:_BuildPopButton()
    local button = ControlButton(self.Header, "PopOutButton", "↗", 1, "ElementHover", function()
        self:PopOut()
    end)

    local right = self.Collapsible and -22 or -4

    button.AnchorPoint = Vector2.new(1, 0.5)
    button.Position = UDim2.new(1, right, 0.5, 0)
    button.Size = UDim2.fromOffset(20, 20)
    button.TextSize = 14
    self.PopButton = button

    -- Make room so the title does not run under the button.
    local title = self.TitleLabel.Size
    self.TitleLabel.Size = UDim2.new(title.X.Scale, title.X.Offset - 22, title.Y.Scale, title.Y.Offset)

    button.MouseEnter:Connect(function()
        self.Window:_TooltipShow("Pop out")
    end)

    button.MouseMoved:Connect(function()
        self.Window:_TooltipMove()
    end)

    button.MouseLeave:Connect(function()
        self.Window:_TooltipHide()
    end)
end

-- The panel frame: shadow, a clipped Surface with a top bar and a scrolling Body.
function Section:_BuildPanel()
    local window = self.Window
    local at = window.Main.AbsolutePosition
    local count = 0

    for _, tab in ipairs(window.Tabs) do
        for section in pairs(tab.Sections) do
            if section.PoppedOut then
                count = count + 1
            end
        end
    end

    local shift = (count % 6) * 24
    local height = math.clamp(self.Tab:_SectionHeight(self) + PANEL_BAR + PANEL_PADDING * 2, PANEL_MIN.Y, PANEL_MAX_HEIGHT)
    local size = self._panelSize or Vector2.new(PANEL_WIDTH, height)

    local panel = Create("Frame", {
        Name = self.Title .. "Panel",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(at.X + 40 + shift, at.Y + 40 + shift),
        Size = UDim2.fromOffset(size.X, size.Y),
        Parent = window:_PanelGui(),
    })

    local shadow = Create("ImageLabel", {
        Name = "Shadow",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, SHADOW_STYLES.Panel[2]),
        Size = UDim2.new(1, SHADOW_STYLES.Panel[1], 1, SHADOW_STYLES.Panel[1]),
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = SHADOW_STYLES.Panel[3],
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = 0,
        Parent = panel,
    })

    Icons.Images[shadow] = true
    self.PanelShadow = shadow

    local surface = Create("CanvasGroup", {
        Name = "Surface",
        Size = UDim2.fromScale(1, 1),
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Background" },
        Parent = panel,
    }, {
        Corner(Metrics.RadiusLarge),
        Stroke("Stroke"),
    })

    local bar = Create("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, PANEL_BAR),
        BorderSizePixel = 0,
        Active = true,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = surface,
    })

    self.PanelTitle = Create("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -80, 1, 0),
        Font = Fonts.Bold,
        TextSize = Metrics.TextTitle,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = self.Title,
        Theme = { TextColor3 = "Accent" },
        Parent = bar,
    })

    local controls = Create("Frame", {
        Name = "Controls",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -6, 0, 0),
        Size = UDim2.new(0, 64, 1, 0),
        Parent = bar,
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
        }),
    })

    self.PanelCollapse = ControlButton(controls, "Collapse", "–", 1, "ElementHover", function()
        self:SetPanelCollapsed(not self.PanelCollapsed)
    end)

    self.PanelRestore = ControlButton(controls, "Restore", "↙", 2, "ElementHover", function()
        self:Restore()
    end)

    self.PanelBody = Create("ScrollingFrame", {
        Name = "Body",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Position = UDim2.fromOffset(0, PANEL_BAR),
        Size = UDim2.new(1, 0, 1, -PANEL_BAR),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Theme = { ScrollBarImageColor3 = "Stroke" },
        Parent = surface,
    })

    -- The section sits in a frame that is narrower than the body by the padding
    -- on both sides (UIPadding does not shrink a child's width reliably here).
    self.PanelContent = Create("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(PANEL_PADDING, PANEL_PADDING),
        Size = UDim2.new(1, -PANEL_PADDING * 2, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = self.PanelBody,
    }, {
        Create("UIPadding", { PaddingBottom = UDim.new(0, PANEL_PADDING) }),
    })

    -- Drag by the top bar, kept on screen.
    bar.InputBegan:Connect(function(input)
        if not IsPress(input) then
            return
        end

        -- The pressed panel comes to the front.
        window._panelTop = (window._panelTop or 0) + 1
        panel.ZIndex = window._panelTop

        local startPointer = input.Position
        local startPosition = panel.Position
        local startAbsolute = panel.AbsolutePosition
        local viewport = window.PanelGui.AbsoluteSize
        local width = panel.AbsoluteSize.X
        local topLimit = MAIN_TOP_LIMIT

        -- Moves by the pointer's distance from where it started. Absolute
        -- coordinates only decide the screen limits, so there is no jump when
        -- the drag begins.
        BeginDrag(input, function(pointer)
            local delta = pointer - startPointer
            local x = math.clamp(startAbsolute.X + delta.X, 60 - width, viewport.X - 60)
            local y = math.clamp(startAbsolute.Y + delta.Y, topLimit, math.max(topLimit, viewport.Y - PANEL_BAR))

            panel.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + (x - startAbsolute.X),
                startPosition.Y.Scale,
                startPosition.Y.Offset + (y - startAbsolute.Y)
            )
        end)
    end)

    self.Panel = panel
    self:_BuildPanelGrip()
end

-- Grip on the panel's bottom-right corner: drag to resize (not while collapsed).
function Section:_BuildPanelGrip()
    local panel = self.Panel
    local window = self.Window

    local grip = Create("Frame", {
        Name = "ResizeHandle",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Active = true,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.fromScale(1, 1),
        Size = UDim2.fromOffset(RESIZE_GRIP, RESIZE_GRIP),
        ZIndex = 11,
        Parent = panel,
    })

    local dots = {}

    for _, at in ipairs({ { 14, 14 }, { 9, 14 }, { 14, 9 } }) do
        dots[#dots + 1] = Create("Frame", {
            Name = "Dot",
            Position = UDim2.fromOffset(at[1], at[2]),
            Size = UDim2.fromOffset(3, 3),
            BorderSizePixel = 0,
            ZIndex = 11,
            Theme = { BackgroundColor3 = "TextMuted" },
            Parent = grip,
        }, {
            Corner(2),
        })
    end

    grip.MouseEnter:Connect(function()
        for _, dot in ipairs(dots) do
            TweenToken(dot, "BackgroundColor3", "Accent")
        end
    end)

    grip.MouseLeave:Connect(function()
        for _, dot in ipairs(dots) do
            TweenToken(dot, "BackgroundColor3", "TextMuted")
        end
    end)

    grip.InputBegan:Connect(function(input)
        if not IsPress(input) or self.PanelCollapsed then
            return
        end

        local startPointer = input.Position
        local startWidth, startHeight = panel.Size.X.Offset, panel.Size.Y.Offset
        local viewport = window.PanelGui.AbsoluteSize
        local at = panel.AbsolutePosition
        local maxWidth = viewport.X > 0 and math.max(PANEL_MIN.X, viewport.X - at.X - 10) or math.huge
        local maxHeight = viewport.Y > 0 and math.max(PANEL_MIN.Y, viewport.Y - at.Y - 10) or math.huge

        BeginDrag(input, function(pointer)
            local delta = pointer - startPointer
            local width = math.clamp(startWidth + delta.X, PANEL_MIN.X, maxWidth)
            local height = math.clamp(startHeight + delta.Y, PANEL_MIN.Y, maxHeight)

            panel.Size = UDim2.fromOffset(width, height)
            self._panelSize = Vector2.new(width, height)
        end)
    end)

    self.PanelGrip = grip
end

-- The stand-in shown in the tab while the section is popped out.
function Section:_BuildPlaceholder()
    local holder = Create("Frame", {
        Name = self.Title .. "Popped",
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, POPPED_HEIGHT),
        Visible = false,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = self.Tab.Columns[1], -- Tab:Rearrange puts it in its column
    }, {
        Corner(Metrics.Radius),
        Stroke("Stroke"),
    })

    Create("TextLabel", {
        Name = "Message",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -110, 1, 0),
        Font = Fonts.Regular,
        TextSize = Metrics.TextSmall + 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = self.Title .. " is popped out",
        Theme = { TextColor3 = "TextDim" },
        Parent = holder,
    })

    local button = Create("TextButton", {
        Name = "RestoreButton",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(84, 26),
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Font = Fonts.Bold,
        TextSize = Metrics.TextSmall + 1,
        Text = "Restore",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Theme = { BackgroundColor3 = "Accent" },
        Parent = holder,
    }, {
        Corner(6),
    })

    button.MouseButton1Click:Connect(function()
        self:Restore()
    end)

    self.Placeholder = holder
end

function Section:PopOut()
    if self.PoppedOut or self.Destroyed then
        return
    end

    self.PoppedOut = true
    self.PanelCollapsed = false

    -- The panel's top bar has its own collapse button, so a section that was
    -- collapsed opens up while it is popped out (and closes again on restore).
    self._collapsedBeforePop = self.Collapsed

    if self.Collapsed then
        self:SetCollapsed(false, true)
    end

    if not self.Panel then
        self:_BuildPanel()
        self:_BuildPlaceholder()
    end

    -- The panel's top bar carries the title and the collapse button.
    self.Header.Visible = false
    self.Frame.LayoutOrder = 0
    self.Frame.Parent = self.PanelContent
    self.Panel.Visible = true
    self.PanelBody.Visible = true
    self.PanelGrip.Visible = true
    self.Placeholder.Visible = true
    self.Tab:Rearrange()
end

function Section:Restore()
    if not self.PoppedOut or self.Destroyed then
        return
    end

    -- A panel minimized to its top bar opens up first, so the next pop-out
    -- does not start from a shrunken panel.
    if self.PanelCollapsed then
        self:SetPanelCollapsed(false)
    end

    self.PoppedOut = false

    if self._collapsedBeforePop then
        self:SetCollapsed(true, true)
    end

    self.Panel.Visible = false
    self.Placeholder.Visible = false
    self.Header.Visible = true
    self.Frame.Parent = self.Tab.Columns[1]
    self.Tab:Rearrange()
end

-- Shows / hides the elements; the panel shrinks to its top bar.
function Section:SetPanelCollapsed(collapsed)
    if not self.PoppedOut or collapsed == self.PanelCollapsed then
        return
    end

    self.PanelCollapsed = collapsed

    local panel = self.Panel

    if collapsed then
        self._panelSize = Vector2.new(panel.Size.X.Offset, panel.Size.Y.Offset)
        panel.Size = UDim2.fromOffset(panel.Size.X.Offset, PANEL_BAR)
    else
        panel.Size = UDim2.fromOffset(panel.Size.X.Offset, self._panelSize.Y)
    end

    self.PanelBody.Visible = not collapsed
    self.PanelGrip.Visible = not collapsed
    SetShadowStyle(self.PanelShadow, collapsed and "Compact" or "Panel")
    self.PanelCollapse.Text = collapsed and "+" or "–"
end

function Window:SetVisible(visible)
    if visible == self.Visible then
        return
    end

    self.Visible = visible
    self.Gui.Enabled = visible
    self:_TooltipHide()
    self:_SyncIsland()
    self.VisibilityChanged:Fire(visible)
end

-- Loading screen ------------------------------------------------------------
--
-- Shown by CreateWindow until Window:Ready(); the window stays hidden. The bar
-- follows real work, in three stages:
--     0 - 60%     your script creating tabs, sections and elements
--     60 - 70%    the icon library (Nebula) finishing its download
--     70 - 100%   every icon / image being preloaded, so nothing pops in later
-- While loading, creating elements yields now and then so the bar can draw.
-- A script that tracks its own progress (loading other scripts, say) can feed
-- the first stage:
--     Window:SetLoading(40, "Loading Dashboard...")      how far the script is, 0 to 100
--     Window:SetLoading(nil, "Almost there")             status text only
-- Ready() ends the first stage, runs the other two, loads the autoload profile
-- and opens the window.

function Window:_BuildLoading()
    local settings = self.Settings
    local hasIcon = settings.Icon ~= ""
    local shift = hasIcon and 44 or 0

    local gui = Create("ScreenGui", {

-- Tiled background with a diagonal fade and a slow scroll.
-- ImageLabel has no TileOffset, so the image is one tile larger than the card
-- and slid by 0 to one tile. The card clips the overflow, so the loop is seamless.
function Home.TiledBackground(card, image, scrollX, scrollY, scrolling)
    local tile = Home.TileSize

    local background = Create("ImageLabel", {
        Name = "Background",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, tile, 1, tile),
        Image = image,
        ImageTransparency = 0.75,
        ScaleType = Enum.ScaleType.Tile,
        TileSize = UDim2.fromOffset(tile, tile),
        Parent = card,
    })

    local gradient = Create("UIGradient", {
        Rotation = 25,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.9, 0),
            NumberSequenceKeypoint.new(1, 0, 0),
        }),
        Parent = background,
    })

    -- Tint with the accent. UIGradient.Color is a ColorSequence, so we build
    -- one from the Color3 token and rebuild it whenever the theme changes.
    local function paint()
        gradient.Color = ColorSequence.new(Theme.Tokens.Accent)
    end

    paint()
    Library:Connect(Theme.Changed, paint)

    scrolling[#scrolling + 1] = { image = background, speedX = scrollX, speedY = scrollY, x = 0, y = 0 }

    return background
end


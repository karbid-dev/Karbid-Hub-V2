local previous = Genv[INSTANCE_KEY]
if type(previous) == "table" and type(previous.Unload) == "function" then
    local ok, err = pcall(previous.Unload, previous)
    if not ok then
        Log("Previous instance cleanup failed:", err)
    end
end
Genv[INSTANCE_KEY] = Library

Icons:Load()

return Library

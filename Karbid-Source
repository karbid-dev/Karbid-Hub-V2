-- Drag the window by its top bar (mouse or touch), kept on screen.
function Window:_BindDrag(handle)
    local topBar = Metrics.TopBarHeight

    handle.InputBegan:Connect(function(input)
        if not IsPress(input) or self.Fullscreen then
            return
        end

        local main = self.Main
        local startPointer = input.Position
        local startPosition = main.Position
        local startAbsolute = main.AbsolutePosition
        local viewport = self.Gui.AbsoluteSize
        local width = main.AbsoluteSize.X
        local topLimit = MAIN_TOP_LIMIT

        BeginDrag(input, function(pointer)
            local delta = pointer - startPointer
            local x = math.clamp(startAbsolute.X + delta.X, 100 - width, viewport.X - 100)
            local y = math.clamp(startAbsolute.Y + delta.Y, topLimit, math.max(topLimit, viewport.Y - topBar))

            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + (x - startAbsolute.X),
                startPosition.Y.Scale,
                startPosition.Y.Offset + (y - startAbsolute.Y)
            )
        end)
    end)
end

-- Only one dropdown / color picker is open at a time.
function Window:_OpenPopup(element)
    local current = self._popup

    if current and current ~= element then
        current:Close()
    end

    self._popup = element
end

function Window:_PopupClosed(element)
    if self._popup == element then
        self._popup = nil
    end
end

function Window:_TooltipShow(text)
    self._tipToken = self._tipToken + 1
    local token = self._tipToken

    task.delay(0.45, function()
        if token ~= self._tipToken or self.Destroyed then
            return
        end

        self.TipLabel.Text = text
        self:_TooltipPlace()
        self.Tip.Visible = true
    end)
end

function Window:_TooltipPlace()
    local pointer = UserInputService:GetMouseLocation()
    local viewport = self.Gui.AbsoluteSize
    local size = self.Tip.AbsoluteSize
    local x = pointer.X + 14
    local y = pointer.Y + 18

    if x + size.X > viewport.X then
        x = pointer.X - size.X - 8
    end

    if y + size.Y > viewport.Y then
        y = pointer.Y - size.Y - 8
    end

    self.Tip.Position = UDim2.fromOffset(x, y)
end

function Window:_TooltipMove()
    if self.Tip.Visible then
        self:_TooltipPlace()
    end
end

function Window:_TooltipHide()
    self._tipToken = self._tipToken + 1
    self.Tip.Visible = false
end

function Window:_SelectTab(tab)
    -- Picking a tab leaves the search results first.
    if self._searching then
        self:ClearSearch()
    end

    if self.ActiveTab == tab then
        return
    end

    if self._popup then
        self._popup:Close()
    end

    if self.ActiveTab then
        self.ActiveTab:_SetActive(false)
    end

    self.ActiveTab = tab
    tab:_SetActive(true)
end

function Window:_RemoveTab(tab)
    for index, candidate in ipairs(self.Tabs) do
        if candidate == tab then
            table.remove(self.Tabs, index)
            break
        end
    end

    if self.ActiveTab == tab then
        self.ActiveTab = nil

        if self.Tabs[1] then
            self:_SelectTab(self.Tabs[1])
        end
    end
end

function Window:AddTab(title, settings)
    if type(title) ~= "string" or title == "" then
        error("AddTab expects a title", 2)
    end

    local tab = Tab.new(self, title, ReadSettings("Tab", title, TAB_SCHEMA, settings, 3))
    self.Tabs[#self.Tabs + 1] = tab

    if not self.ActiveTab then
        tab:Select()
    end

    self:_LoadWork()
    return tab
end


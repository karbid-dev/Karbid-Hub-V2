end)

local Toast = {}
Toast.__index = Toast

-- Slides the toast out and closes the gap it leaves. Safe to call twice.
function Toast:Dismiss()
    if self.Dismissed or Library.Unloaded then
        return
    end
    self.Dismissed = true

    for index, active in ipairs(Notifier.Active) do
        if active == self then
            table.remove(Notifier.Active, index)
            break
        end
    end

    local wrapper = self._wrapper
    local height = wrapper.AbsoluteSize.Y

    wrapper.AutomaticSize = Enum.AutomaticSize.None
    wrapper.Size = UDim2.new(1, 0, 0, height)

    Tween(self._card, "Hover", { Position = UDim2.new(0, NOTIFY_OFFSCREEN, 0, 0) })
    Tween(wrapper, "Hover", { Size = UDim2.new(1, 0, 0, 0) })

    task.delay(0.35, function()
        wrapper:Destroy()
    end)
end

function Library:Notify(settings)
    if self.Unloaded then
        return nil
    end

    local given = type(settings) == "string" and { Title = settings } or settings
    local name = type(given) == "table" and given.Title or "Notify"
    settings = ReadSettings("Notify", tostring(name), NOTIFY_SCHEMA, given, 3)

    local token = NOTIFY_TYPES[settings.Type]
    if not token then
        error(string.format("Notify: Type must be Info, Success, Warning or Error, got '%s'", settings.Type), 2)
    end

    if settings.Duration < 0 then
        error("Notify: Duration cannot be negative", 2)
    end

    local holder = Notifier:_EnsureHolder()
    Notifier.Order = Notifier.Order + 1

    local hasIcon = settings.Icon ~= ""
    local hasContent = settings.Content ~= ""

    local wrapper = Create("Frame", {
        Name = "Toast",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = Notifier.Order,
        Parent = holder,
    })

    local card = Create("CanvasGroup", {
        Name = "Card",
        BorderSizePixel = 0,
        Position = UDim2.new(0, NOTIFY_OFFSCREEN, 0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = wrapper,
    }, {
        Corner(),
        Stroke("Stroke"),
    })

    -- Text column. The accent bar, icon and progress bar sit beside it, so the
    -- list layout only ever arranges the two text labels.
    Create("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = card,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 2),
        }),
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingBottom = UDim.new(0, 14),
            PaddingLeft = UDim.new(0, 16 + (hasIcon and 26 or 0)),
            PaddingRight = UDim.new(0, 12),
        }),
        Create("TextLabel", {
            Name = "Title",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Fonts.Bold,
            TextSize = Metrics.TextBody,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            Text = settings.Title,
            LayoutOrder = 1,
            Theme = { TextColor3 = "Text" },
        }),
        Create("TextLabel", {
            Name = "Body",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Fonts.Regular,
            TextSize = Metrics.TextSmall,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            Text = settings.Content,
            Visible = hasContent,
            LayoutOrder = 2,
            Theme = { TextColor3 = "TextDim" },
        }),
    })

    Create("Frame", {
        Name = "Accent",
        Size = UDim2.new(0, 3, 1, 0),
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = token },
        Parent = card,
    })

    if hasIcon then
        local icon = Create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 10),
            Size = UDim2.fromOffset(18, 18),
            Theme = { ImageColor3 = token },
            Parent = card,
        })

        Icons:Apply(icon, settings.Icon)
    end

    local timer = Create("Frame", {
        Name = "Timer",
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Visible = settings.Duration > 0,
        Theme = { BackgroundColor3 = token },
        Parent = card,
    })

    local toast = setmetatable({
        Settings = settings,
        Dismissed = false,
        _wrapper = wrapper,
        _card = card,
    }, Toast)

    Notifier.Active[#Notifier.Active + 1] = toast

    -- The oldest toast makes room.
    while #Notifier.Active > NOTIFY_MAX do
        Notifier.Active[1]:Dismiss()
    end

    -- The CanvasGroup clips to the rounded corners but cannot be clicked, so a
    -- transparent button covers it.
    local hit = Create("TextButton", {
        Name = "Hit",
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 5,
        Parent = card,
    })

    hit.MouseButton1Click:Connect(function()
        toast:Dismiss()
    end)

    Tween(card, "Show", { Position = UDim2.new(0, 0, 0, 0) })

    if settings.Duration > 0 then
        Tween(timer, TweenInfo.new(settings.Duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })

        task.delay(settings.Duration, function()
            toast:Dismiss()
        end)
    end

    return toast
end

-- ----------------------------------------------------------------------------
-- Config profiles
--
-- A profile is a JSON file "<ConfigFolder>/<name>.json" that holds the value of
-- every option with a flag (toggles, sliders, inputs, dropdowns, keybinds,
-- color pickers) and the theme. Elements created with IgnoreConfig = true are
-- left out. Without a file API (Studio) profiles live in memory instead.
--
--     Library.Config:Save("Main")           --> true, "Main"   or   false, "reason"
--     Library.Config:Load("Main")           --> true, { Name, Loaded, Skipped }
--     Library.Config:List()                 --> { "Main", "Other" }
--     Library.Config:SetAutoload("Main")    --> loaded by Window:Ready()
-- ----------------------------------------------------------------------------

local HttpService = GetService("HttpService")
local TeleportService = GetService("TeleportService")
local MarketplaceService = GetService("MarketplaceService")

local CONFIG_VERSION = 1
local AUTOLOAD_FILE = "autoload.txt"
local NAME_LIMIT = 40

-- Profile and folder names: letters, digits, space, dash and underscore only,
-- so a name can never point outside its folder.
local function CleanName(text)
    if type(text) ~= "string" then
        return nil
    end

    text = Trim((string.gsub(text, "[^%w %-_]", "")))
    text = Trim(string.sub(text, 1, NAME_LIMIT))

    return text ~= "" and text or nil
end

-- Runs fn and returns (true, result) or (false, errorMessage).
local function Try(fn, ...)
    local ok, result = pcall(fn, ...)

    if ok then
        return true, result
    end

    return false, tostring(result)
end

local function MakeMemoryStorage()
    local files = {}

    return {
        Memory = true,
        Ensure = function() end,
        Read = function(path)
            return files[path]
        end,
        Write = function(path, text)
            files[path] = text
        end,
        Delete = function(path)
            files[path] = nil
        end,
        List = function(folder)
            local paths = {}
            local prefix = folder .. "/"

            for path in pairs(files) do
                if string.sub(path, 1, #prefix) == prefix then
                    paths[#paths + 1] = path
                end
            end

            return paths
        end,
    }
end

local function MakeFileStorage()
    return {
        Memory = false,
        Ensure = function(folder)
            if not isfolder(folder) then
                makefolder(folder)
            end
        end,
        Read = function(path)
            if isfile(path) then
                return readfile(path)
            end

            return nil
        end,
        Write = function(path, text)
            writefile(path, text)
        end,
        Delete = function(path)
            if isfile(path) then
                delfile(path)
            end
        end,
        List = function(folder)
            if isfolder(folder) then
                return listfiles(folder)
            end

            return {}
        end,
    }
end

local Config = {
    Folder = LIBRARY_NAME,
    Current = nil, -- name of the profile loaded last
    Changed = Signal.new(), -- fires when a profile is saved, deleted or the autoload changes
    Storage = Env.HasFileApi and MakeFileStorage() or MakeMemoryStorage(),
}

Config.Memory = Config.Storage.Memory
Library.Config = Config

-- Returns false when the name has nothing usable in it.
function Config:SetFolder(name)
    local clean = CleanName(name)

    if not clean then
        return false
    end

    self.Folder = clean
    return true
end

function Config:_Path(name)
    return self.Folder .. "/" .. name .. ".json"
end

function Config:_AutoloadPath()
    return self.Folder .. "/" .. AUTOLOAD_FILE
end

function Config:_Exists(name)
    local ok, text = Try(self.Storage.Read, self:_Path(name))
    return ok and text ~= nil
end

-- Profile names, sorted.
function Config:List()
    local ok, paths = Try(self.Storage.List, self.Folder)
    local names = {}

    if ok and type(paths) == "table" then
        for _, path in ipairs(paths) do
            local name = string.match(tostring(path), "([^/\\]+)%.json$")

            if name then
                names[#names + 1] = name
            end
        end
    end

    table.sort(names, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    return names
end

-- The current value of every savable option, as plain data.
function Config:Export()
    local flags = {}

    for flag, option in pairs(Library.Options) do
        if option.Savable and not option.IgnoreConfig then
            local ok, value = pcall(option.GetSaveData, option)

            if ok and value ~= nil then
                flags[flag] = { Class = option.Class, Value = value }
            end
        end
    end

    local data = {
        Version = CONFIG_VERSION,
        Library = LIBRARY_NAME,
        Theme = Theme.Base or Theme.Name,
        Flags = flags,
    }

    -- A custom accent color is kept on top of the preset it started from.
    if Theme.Name == "Custom" then
        data.Accent = ColorToHex(Theme.Tokens.Accent)
    end

    return data
end

-- Applies exported data. Options that no longer exist, or whose type changed,
-- are skipped. Returns { Loaded, Skipped } or nil plus a reason.
function Config:Import(data)
    if type(data) ~= "table" or type(data.Flags) ~= "table" then
        return nil, "The config has no settings in it"
    end

    if type(data.Version) == "number" and data.Version > CONFIG_VERSION then
        Log(string.format("Config was saved by a newer version (%d); loading what is understood", data.Version))
    end

    if type(data.Theme) == "string" and Theme.Presets[data.Theme] then
        if Theme.Name ~= data.Theme or data.Accent ~= nil then
            Theme:Set(data.Theme)
        end

        local accent = type(data.Accent) == "string" and HexToColor(data.Accent)
        if accent then
            Theme:SetToken("Accent", accent)
        end
    end

    local flags = {}
    for flag in pairs(data.Flags) do
        flags[#flags + 1] = flag
    end

    table.sort(flags)

    local loaded, skipped = 0, 0

    for _, flag in ipairs(flags) do
        local entry = data.Flags[flag]
        local option = Library.Options[flag]

        if
            type(entry) == "table"
            and entry.Value ~= nil
            and option
            and option.Savable
            and not option.IgnoreConfig
            and option.Class == entry.Class
        then
            local ok, err = pcall(option.LoadSaveData, option, entry.Value)

            if ok then
                loaded = loaded + 1
            else
                skipped = skipped + 1
                Log(string.format("Config: could not load '%s': %s", tostring(flag), tostring(err)))
            end
        else
            skipped = skipped + 1
        end
    end

    return { Loaded = loaded, Skipped = skipped }
end

function Config:Save(name)
    local clean = CleanName(name)

    if not clean then
        return false, "Enter a profile name (letters, digits, spaces, - and _)"
    end

    local encoded, text = Try(function()
        return HttpService:JSONEncode(self:Export())
    end)

    if not encoded then
        return false, "Could not encode the config: " .. text
    end

    local written, err = Try(function()
        self.Storage.Ensure(self.Folder)
        self.Storage.Write(self:_Path(clean), text)
    end)

    if not written then
        return false, "Could not write the config: " .. err
    end

    self.Changed:Fire(clean)
    return true, clean
end

function Config:Load(name)
    local clean = CleanName(name)

    if not clean then
        return false, "Invalid profile name"
    end

    local read, text = Try(self.Storage.Read, self:_Path(clean))

    if not read then
        return false, "Could not read the config: " .. text
    end

    if text == nil then
        return false, string.format("Profile '%s' does not exist", clean)
    end

    local decoded, data = Try(function()
        return HttpService:JSONDecode(text)
    end)

    if not decoded then
        return false, string.format("Profile '%s' is damaged", clean)
    end

    local summary, reason = self:Import(data)

    if not summary then
        return false, reason
    end

    summary.Name = clean
    self.Current = clean

    return true, summary
end

function Config:Delete(name)
    local clean = CleanName(name)

    if not clean then
        return false, "Invalid profile name"
    end

    if not self:_Exists(clean) then
        return false, string.format("Profile '%s' does not exist", clean)
    end

    local deleted, err = Try(self.Storage.Delete, self:_Path(clean))

    if not deleted then
        return false, "Could not delete the config: " .. err
    end

    if self:GetAutoload() == clean then
        Try(self.Storage.Delete, self:_AutoloadPath())
    end

    if self.Current == clean then
        self.Current = nil
    end

    self.Changed:Fire(clean)
    return true
end

-- The profile loaded by Window:Ready(), or nil.
function Config:GetAutoload()
    local ok, text = Try(self.Storage.Read, self:_AutoloadPath())

    if not ok or type(text) ~= "string" then
        return nil
    end

    return CleanName(text)
end

-- SetAutoload("Main") picks a saved profile, SetAutoload(nil) clears it.
function Config:SetAutoload(name)
    if name == nil then
        Try(self.Storage.Delete, self:_AutoloadPath())
        self.Changed:Fire(nil)
        return true
    end

    local clean = CleanName(name)

    if not clean or not self:_Exists(clean) then
        return false, string.format("Profile '%s' does not exist", tostring(name))
    end

    local written, err = Try(function()
        self.Storage.Ensure(self.Folder)
        self.Storage.Write(self:_AutoloadPath(), clean)
    end)

    if not written then
        return false, "Could not save the autoload: " .. err
    end

    self.Changed:Fire(clean)
    return true
end

-- Returns nil when no autoload profile is set, otherwise the result of Load.
function Config:LoadAutoload()
    local name = self:GetAutoload()

    if not name then
        return nil
    end

    return self:Load(name)
end

-- Call once, after every element has been created: loads the autoload profile
-- and tells the user what happened. Calling it again does nothing.
function Window:Ready()
    if self._ready then
        return
    end
    self._ready = true

    if self.Loading then
        self:SetLoading(nil, "Loading config...")
    end

    local ok, result = Config:LoadAutoload()

    local function announce()
        if ok == nil then
            return
        end

        if ok then
            Library:Notify({
                Title = "Config loaded",
                Content = string.format("%s (%d options)", result.Name, result.Loaded),
                Type = "Success",
                Duration = 3,
            })
        else
            Library:Notify({ Title = "Autoload failed", Content = tostring(result), Type = "Warning" })
        end
    end

    -- With a loading screen the toast waits until the window is on screen.
    if self.Loading then
        self:_FinishLoading(announce)
    else
        announce()
    end
end

-- ----------------------------------------------------------------------------
-- Settings tab
--
--     Window:AddSettingsTab()      one call: profiles, theme, menu key, unload
-- ----------------------------------------------------------------------------

local SETTINGS_SCHEMA = {
    Title = { "Settings", "string" },
    Icon = { "settings", "string", "number" },
}

function Window:AddSettingsTab(settings)
    if self.SettingsTab then
        error("AddSettingsTab: the settings tab already exists", 2)
    end

    settings = ReadSettings("SettingsTab", "Settings", SETTINGS_SCHEMA, settings, 3)

    local window = self
    local tab = self:AddTab(settings.Title, { Icon = settings.Icon })
    self.SettingsTab = tab

    local function say(kind, title, content)
        Library:Notify({ Title = title, Content = content or "", Type = kind, Duration = 3 })
    end

    -- Configuration ----------------------------------------------------------
    local profiles = tab:AddSection("Configuration", { Column = "Left" })

    if Config.Memory then
        profiles:AddLabel({
            Text = "File access is not available here, so profiles only last until the script is unloaded.",
            Style = "Warning",
        })
    end

    local nameInput = profiles:AddInput("__ConfigName", {
        Title = "Profile name",
        Placeholder = "My profile",
        MaxLength = NAME_LIMIT,
        Trigger = "Change",
        IgnoreConfig = true,
    })

    local list = profiles:AddDropdown("__ConfigList", {
        Title = "Profiles",
        Options = Config:List(),
        Placeholder = "None selected",
        IgnoreConfig = true,
    })

    local autoloadLabel = profiles:AddLabel({ Text = "Autoload: none", Style = "Info" })

    -- The profile an action applies to: the selected one, else the typed name.
    local function target()
        local typed = CleanName(nameInput.Value)
        return list.Value or typed
    end

    local function refresh()
        if list.Destroyed then
            return
        end

        list:SetOptions(Config:List())

        local autoload = Config:GetAutoload()
        autoloadLabel:SetText(autoload and ("Autoload: " .. autoload) or "Autoload: none")
    end

    profiles:AddButton({
        Title = "Save",
        Description = "Saves every option under the typed name (or over the selected profile)",
        Callback = function()
            local name = CleanName(nameInput.Value) or list.Value

            if not name then
                say("Warning", "Enter a profile name first")
                return
            end

            local ok, result = Config:Save(name)

            if ok then
                nameInput:SetValue("", true)
                list:SetValue(result, true)
                say("Success", "Saved", result)
            else
                say("Error", "Save failed", result)
            end
        end,
    })

    profiles:AddButton({
        Title = "Load",
        Description = "Applies the selected profile",
        Callback = function()
            local name = target()

            if not name then
                say("Warning", "Select a profile first")
                return
            end

            local ok, result = Config:Load(name)

            if ok then
                say("Success", "Loaded", string.format("%s (%d options)", result.Name, result.Loaded))
            else
                say("Error", "Load failed", result)
            end
        end,
    })

    -- Delete asks for a second click so one slip cannot remove a profile.
    local armed, armedToken = nil, 0
    local deleteButton

    deleteButton = profiles:AddButton({
        Title = "Delete",
        Description = "Removes the selected profile",
        Callback = function()
            local name = target()

            if not name then
                say("Warning", "Select a profile first")
                return
            end

            if armed ~= name then
                armed = name
                armedToken = armedToken + 1
                local token = armedToken

                deleteButton:SetTitle("Click again to delete '" .. name .. "'")

                task.delay(3, function()
                    if token == armedToken and not deleteButton.Destroyed then
                        armed = nil
                        deleteButton:SetTitle("Delete")
                    end
                end)

                return
            end

            armed = nil
            armedToken = armedToken + 1
            deleteButton:SetTitle("Delete")

            local ok, result = Config:Delete(name)

            if ok then
                say("Success", "Deleted", name)
            else
                say("Error", "Delete failed", result)
            end
        end,
    })

    profiles:AddButton({
        Title = "Set as autoload",
        Description = "Loads the selected profile whenever the script starts",
        Callback = function()
            local name = target()

            if not name then
                say("Warning", "Select a profile first")
                return
            end

            local ok, result = Config:SetAutoload(name)

            if ok then
                say("Success", "Autoload set", name)
            else
                say("Error", "Could not set autoload", result)
            end
        end,
    })

    profiles:AddButton({
        Title = "Clear autoload",
        Callback = function()
            Config:SetAutoload(nil)
            say("Info", "Autoload cleared")
        end,
    })

    Library:Connect(Config.Changed, refresh)
    refresh()

    -- Interface --------------------------------------------------------------
    local interface = tab:AddSection("Interface", { Column = "Right" })

    local themeList = interface:AddDropdown({
        Title = "Theme",
        Options = Theme:GetNames(),
        Placeholder = "Custom",
        Callback = function(name)
            if name and Theme.Name ~= name then
                Theme:Set(name)
            end
        end,
    })

    local accent = interface:AddColorPicker({
        Title = "Accent color",
        Default = Theme.Tokens.Accent,
        Callback = function(color)
            Theme:SetToken("Accent", color)
        end,
    })

    -- Keeps both controls in step when the theme changes from anywhere (a
    -- loaded profile, a script calling Theme:Set, the other control).
    local function syncTheme()
        if themeList.Destroyed then
            return
        end

        themeList:SetValue(Theme.Presets[Theme.Name] and Theme.Name or nil, true)

        if ColorToHex(accent.Value) ~= ColorToHex(Theme.Tokens.Accent) then
            accent:SetValue(Theme.Tokens.Accent, true)
        end
    end

    syncTheme()
    Library:Connect(Theme.Changed, syncTheme)

    -- Only a real keyboard key can open the menu again, so anything else is undone.
    local menuKey
    menuKey = interface:AddKeybind("__MenuKey", {
        Title = "Menu key",
        Description = "Shows or hides the window",
        Default = self.ToggleKey.Name,
        OnBind = function(name)
            local ok, code = pcall(function()
                return Enum.KeyCode[name]
            end)

            if ok and typeof(code) == "EnumItem" then
                window:SetToggleKey(code)
            else
                menuKey:SetValue(window.ToggleKey.Name)
            end
        end,
    })

    interface:AddButton({
        Title = "Unload",
        Description = "Removes the interface and stops every loop",
        Callback = function()
            Library:Unload()
        end,
    })

    -- About ------------------------------------------------------------------
    local about = tab:AddSection("About", { Collapsed = true, Column = "Left" })

    about:AddParagraph({
        Title = LIBRARY_NAME,
        Text = "Version " .. LIBRARY_VERSION,
    })

    return tab
end


        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, Metrics.Gap),
        }),
        Padding(Metrics.Padding),
    })

    self.SearchBox = box
    self.SearchPage = page
    self.SearchEmpty = Create("TextLabel", {
        Name = "Empty",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 40),
        Font = Fonts.Regular,
        TextSize = Metrics.TextBody,
        Text = "No matching options",
        Visible = false,
        LayoutOrder = 0,
        Theme = { TextColor3 = "TextMuted" },
        Parent = page,
    })

    box.Focused:Connect(function()
        TweenToken(boxStroke, "Color", "Accent")
    end)

    box.FocusLost:Connect(function()
        TweenToken(boxStroke, "Color", "Stroke")
    end)

    -- Results follow the text a moment after the last keystroke, so fast typing
    -- builds the list once instead of on every letter. Clearing is instant.
    box:GetPropertyChangedSignal("Text"):Connect(function()
        self._searchToken = self._searchToken + 1
        local token = self._searchToken

        if Trim(box.Text) == "" then
            self:_RenderSearch("")
            return
        end

        task.delay(SEARCH_DELAY, function()
            if token == self._searchToken and not self.Destroyed then
                self:_RenderSearch(box.Text)
            end
        end)
    end)
end

-- Visible, searchable elements matching `query`, best match first: titles that
-- start with it, then titles that contain it, then description / section / tab.
function Window:Search(query)
    query = string.lower(Trim(query or ""))

    if query == "" then
        return {}
    end

    local tabIndex = {}
    for index, tab in ipairs(self.Tabs) do
        tabIndex[tab] = index
    end

    local found = {}

    for element in pairs(self.Elements) do
        if element.Class ~= "Label" and element:IsVisible() then
            local title = string.lower(element.Title)
            local score

            if string.find(title, query, 1, true) == 1 then
                score = 0
            elseif string.find(title, query, 1, true) then
                score = 1
            else
                local extra = string.lower(table.concat({
                    element.Settings.Description or "",
                    element.Section.Title,
                    element.Section.Tab.Title,
                }, " "))

                if string.find(extra, query, 1, true) then
                    score = 2
                end
            end

            if score then
                found[#found + 1] = {
                    Element = element,
                    Score = score,
                    Tab = tabIndex[element.Section.Tab] or 0,
                    Section = element.Section.Frame.LayoutOrder,
                    Order = element.Card.LayoutOrder,
                }
            end
        end
    end

    table.sort(found, function(a, b)
        if a.Score ~= b.Score then
            return a.Score < b.Score
        end

        if a.Tab ~= b.Tab then
            return a.Tab < b.Tab
        end

        if a.Section ~= b.Section then
            return a.Section < b.Section
        end

        return a.Order < b.Order
    end)

    local results = {}
    for index = 1, math.min(#found, SEARCH_MAX_RESULTS) do
        results[index] = found[index].Element
    end

    return results
end

function Window:_ClearResults()
    for _, row in ipairs(self._searchRows) do
        row:Destroy()
    end

    self._searchRows = {}
end

function Window:_SearchRow(element, order)
    local row = Create("TextButton", {

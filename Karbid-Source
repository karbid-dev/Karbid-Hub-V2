-- Toggle
-- ----------------------------------------------------------------------------

local Toggle = setmetatable({}, { __index = Element })
Toggle.__index = Toggle
Toggle.ClassName = "Toggle"
Toggle.Savable = true

local TOGGLE_SCHEMA = Merge(COMMON_SCHEMA, {
    Title = { "Toggle", "string" },
    Default = { false, "boolean" },
    Callback = { NOOP, "function" },
    OnTick = { false, "function", "boolean" }, -- loop that runs while the toggle is on
    Every = { 0.1, "number" }, -- seconds between ticks, 0 = every frame
})

function Toggle.new(section, flag, settings, class)
    class = class or Toggle -- ToggleKeybind builds on this

    if settings.Every < 0 then
        error(string.format("Toggle '%s': Every cannot be negative", settings.Title), 3)
    end

    local self = Element.new(class, section, flag, settings, {
        Interactive = true,
        Reserve = TRACK_WIDTH + Metrics.ElementPadding + (class.ExtraReserve or 0),
    })

    self.Value = false
    self.Default = settings.Default
    self._loop = nil
    self._tickFailed = false

    local trackStroke = Stroke("Stroke", 1, Metrics.StrokeTransparency)

    local track = Create("Frame", {
        Name = "Track",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -Metrics.ElementPadding, 0.5, 0),
        Size = UDim2.fromOffset(TRACK_WIDTH, TRACK_HEIGHT),
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = self.Card,
    }, {
        Corner(TRACK_HEIGHT / 2),
        trackStroke,
    })

    local knob = Create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, KNOB_OFF, 0.5, 0),
        Size = UDim2.fromOffset(KNOB_SIZE, KNOB_SIZE),
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Text" },
        Parent = track,
    }, {
        Corner(KNOB_SIZE / 2),
    })

    self.Track = track
    self.Knob = knob

    self:_Fade(track, "BackgroundTransparency", 0)
    self:_Fade(trackStroke, "Transparency", Metrics.StrokeTransparency)
    self:_Fade(knob, "BackgroundTransparency", 0)

    self.Hit.MouseButton1Click:Connect(function()
        self:SetValue(not self.Value)
    end)

    if self._BuildExtras then
        self:_BuildExtras()
    end

    self:_Finish()

    -- A toggle that starts on runs its callback and loop right away, so what
    -- you see always matches what is running.
    if settings.Default then
        self:_Set(true, false, true)
    end

    return self
end

function Toggle:_Render(instant)
    local on = self.Value
    local token = on and "Accent" or "Surface"
    local knobPosition = UDim2.new(0, on and KNOB_ON or KNOB_OFF, 0.5, 0)

    if instant then
        Theme:Bind(self.Track, { BackgroundColor3 = token })
        self.Knob.Position = knobPosition
    else
        TweenToken(self.Track, "BackgroundColor3", token)
        Tween(self.Knob, "Hover", { Position = knobPosition })
    end
end

-- Starts the OnTick loop while the toggle is on, stops it when it is off.
function Toggle:_SyncLoop()
    local wanted = self.Value and type(self.Settings.OnTick) == "function"

    if wanted and not self._loop then
        self._tickFailed = false
        self._loop = Library:Every(self.Settings.Every, function(dt)
            self:_Tick(dt)
        end)
    elseif not wanted and self._loop then
        self._loop:Disconnect()
        self._loop = nil
    end
end

-- A failing tick is reported once per activation (not 10 times a second).
function Toggle:_Tick(dt)
    local ok, err = xpcall(self.Settings.OnTick, TraceHandler, dt)

    if not ok and not self._tickFailed then
        self._tickFailed = true
        self:_ReportError(err)
    end
end

function Toggle:_Set(value, silent, instant)
    value = value and true or false

    if self.Destroyed or value == self.Value then
        return
    end

    self.Value = value
    self:_Render(instant)
    self:_SyncLoop()
    Library.OptionChanged:Fire(self.Flag)

    if not silent then
        self:_Call(self.Settings.Callback, value)
    end
end

-- silent = true skips the Callback (the loop still follows the value).
function Toggle:SetValue(value, silent)
    self:_Set(value, silent, false)
end

function Toggle:GetValue()
    return self.Value
end

function Toggle:Toggle()
    self:SetValue(not self.Value)
end

function Toggle:GetSaveData()
    return self.Value
end

function Toggle:LoadSaveData(data)
    if type(data) == "boolean" then
        self:SetValue(data)
    end
end

function Toggle:Destroy()
    if self._loop then
        self._loop:Disconnect()
        self._loop = nil
    end

    Element.Destroy(self)
end


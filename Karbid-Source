-- Slider
-- ----------------------------------------------------------------------------

local Slider = setmetatable({}, { __index = Element })
Slider.__index = Slider
Slider.ClassName = "Slider"
Slider.Savable = true

local SLIDER_SCHEMA = Merge(COMMON_SCHEMA, {
    Title = { "Slider", "string" },
    Min = { 0, "number" },
    Max = { 100, "number" },
    Default = { false, "boolean", "number" }, -- false = start at Min
    Step = { 1, "number" },
    Suffix = { "", "string" },
    Callback = { NOOP, "function" },
})

-- How many decimals a step needs (0.25 -> 2), so values print and round cleanly.
local function CountDecimals(step)
    local text = string.format("%.6f", step)
    text = string.gsub(text, "0+$", "")

    local fraction = string.match(text, "%.(%d*)$")
    return fraction and #fraction or 0
end

local SLIDER_KNOB = 14 -- the footer clips, so the track stays half a knob inside it

function Slider.new(section, flag, settings)
    if settings.Max <= settings.Min then
        error(string.format("Slider '%s': Max must be greater than Min", settings.Title), 3)
    end

    if settings.Step <= 0 then
        error(string.format("Slider '%s': Step must be greater than 0", settings.Title), 3)
    end

    local self = Element.new(Slider, section, flag, settings, {
        Interactive = true,
        Reserve = 70,
        Footer = 16,
    })

    self.Min = settings.Min
    self.Max = settings.Max
    self.Step = settings.Step
    self.Decimals = CountDecimals(settings.Step)
    self.Value = self:_Snap(settings.Default == false and settings.Min or settings.Default)

    self.ValueLabel = Create("TextLabel", {
        Name = "Value",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(60, 16),
        Font = Fonts.Medium,
        TextSize = Metrics.TextSmall + 1,
        TextXAlignment = Enum.TextXAlignment.Right,
        Theme = { TextColor3 = "TextDim" },
        Parent = self.Card,
    })

    self:_PlaceControl(self.ValueLabel, Metrics.ElementPadding)
    self:_Fade(self.ValueLabel, "TextTransparency", 0)

    local track = Create("Frame", {
        Name = "Track",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, SLIDER_KNOB / 2, 0.5, 0),
        Size = UDim2.new(1, -SLIDER_KNOB, 0, 6),
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = self.Footer,
    }, {
        Corner(3),
    })

    local fill = Create("Frame", {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0),
        BorderSizePixel = 0,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Parent = track,
    }, {
        Corner(3),
        Create("UIGradient", { Theme = { Color = "Gradient" } }),
    })

    local knob = Create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(SLIDER_KNOB, SLIDER_KNOB),
        BorderSizePixel = 0,
        ZIndex = 2,
        Theme = { BackgroundColor3 = "Text" },
        Parent = track,
    }, {
        Corner(7),
    })

    local drag = Create("TextButton", {
        Name = "Drag",
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 3,
        Parent = self.Footer,
    })

    self.Track = track
    self.Fill = fill
    self.Knob = knob

    self:_Fade(track, "BackgroundTransparency", 0)
    self:_Fade(fill, "BackgroundTransparency", 0)
    self:_Fade(knob, "BackgroundTransparency", 0)

    drag.InputBegan:Connect(function(input)
        if IsPress(input) then
            BeginDrag(input, function(pointer)
                self:_FromPointer(pointer.X)
            end, true, section.Scroll)
        end
    end)

    drag.MouseEnter:Connect(function()
        self:_SetHover(true)
    end)

    drag.MouseLeave:Connect(function()
        self:_SetHover(false)
    end)

    self:_Render(true)
    self:_Finish()

    -- An explicit Default runs the callback once, so the value in use matches
    -- the value shown.
    if settings.Default ~= false then
        self:_Call(settings.Callback, self.Value)
    end

    return self
end

function Slider:_Snap(value)
    local steps = math.floor((value - self.Min) / self.Step + 0.5)
    value = math.clamp(self.Min + steps * self.Step, self.Min, self.Max)

    return tonumber(string.format("%." .. self.Decimals .. "f", value))
end

function Slider:_Render(instant)
    local ratio = (self.Value - self.Min) / (self.Max - self.Min)

    self.ValueLabel.Text = string.format("%." .. self.Decimals .. "f", self.Value) .. self.Settings.Suffix

    if instant then
        self.Fill.Size = UDim2.new(ratio, 0, 1, 0)
        self.Knob.Position = UDim2.new(ratio, 0, 0.5, 0)
    else
        Tween(self.Fill, "Fill", { Size = UDim2.new(ratio, 0, 1, 0) })
        Tween(self.Knob, "Fill", { Position = UDim2.new(ratio, 0, 0.5, 0) })
    end
end

function Slider:_FromPointer(x)
    local width = self.Track.AbsoluteSize.X

    if self.Destroyed or width <= 0 then
        return
    end

    local ratio = math.clamp((x - self.Track.AbsolutePosition.X) / width, 0, 1)
    self:_Set(self.Min + ratio * (self.Max - self.Min), false, true)
end

function Slider:_Set(value, silent, instant)
    value = self:_Snap(value)

    if self.Destroyed or value == self.Value then
        return
    end

    self.Value = value
    self:_Render(instant)
    Library.OptionChanged:Fire(self.Flag)

    if not silent then
        self:_Call(self.Settings.Callback, value)
    end
end

function Slider:SetValue(value, silent)
    if type(value) ~= "number" then
        error("Slider:SetValue expects a number", 2)
    end

    self:_Set(value, silent, false)
end

function Slider:GetValue()
    return self.Value
end

function Slider:GetSaveData()
    return self.Value
end

function Slider:LoadSaveData(data)
    if type(data) == "number" then
        self:_Set(data, false, false)
    end
end

-- ----------------------------------------------------------------------------
-- Input (text box)
-- ----------------------------------------------------------------------------

local Input = setmetatable({}, { __index = Element })
Input.__index = Input
Input.ClassName = "Input"
Input.Savable = true

local INPUT_BOX_WIDTH = 130
local INPUT_TRIGGERS = { Change = true, FocusLost = true, Enter = true }

local INPUT_SCHEMA = Merge(COMMON_SCHEMA, {
    Title = { "Input", "string" },
    Default = { "", "string", "number" },
    Placeholder = { "", "string" },
    Numeric = { false, "boolean" },
    MaxLength = { 0, "number" }, -- 0 = no limit
    ClearOnFocus = { false, "boolean" },
    Trigger = { "FocusLost", "string" }, -- when Callback runs: Change, FocusLost or Enter
    Callback = { NOOP, "function" },
})

-- Keeps digits, one leading minus and one dot: "1a2.3.4" -> "12.34".
local function SanitizeNumber(text)
    text = string.gsub(text, "[^%d%.%-]", "")

    local negative = string.sub(text, 1, 1) == "-"
    text = string.gsub(text, "%-", "")

    local whole, rest = string.match(text, "^([^%.]*)%.?(.*)$")
    rest = string.gsub(rest, "%.", "")

    local result = whole
    if string.find(text, ".", 1, true) then
        result = whole .. "." .. rest
    end

    return (negative and "-" or "") .. result
end

function Input.new(section, flag, settings)
    if not INPUT_TRIGGERS[settings.Trigger] then
        error(string.format("Input '%s': Trigger must be Change, FocusLost or Enter", settings.Title), 3)
    end

    local self = Element.new(Input, section, flag, settings, {
        Interactive = true,
        Reserve = INPUT_BOX_WIDTH + Metrics.ElementPadding,
        HitInset = INPUT_BOX_WIDTH + Metrics.ElementPadding,
    })

    local default = settings.Default
    if settings.Numeric then
        default = tonumber(default) or 0
    end

    self.Value = default
    self._filtering = false

    local boxStroke = Stroke("Stroke", 1, Metrics.StrokeTransparency)

    local box = Create("TextBox", {
        Name = "Box",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -Metrics.ElementPadding, 0.5, 0),
        Size = UDim2.fromOffset(INPUT_BOX_WIDTH, 24),
        BorderSizePixel = 0,
        ClearTextOnFocus = settings.ClearOnFocus,
        Font = Fonts.Regular,
        TextSize = Metrics.TextSmall + 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        PlaceholderText = settings.Placeholder,
        Text = tostring(default),
        Theme = {
            BackgroundColor3 = "Surface",
            TextColor3 = "Text",
            PlaceholderColor3 = "TextMuted",
        },
        Parent = self.Card,
    }, {
        Corner(6),
        boxStroke,
        Padding(0, 8),
    })

    self.Box = box
    self:_Fade(box, "BackgroundTransparency", 0)
    self:_Fade(boxStroke, "Transparency", Metrics.StrokeTransparency)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        if self._filtering then
            return
        end

        local text = box.Text
        local clean = self:_Sanitize(text)

        if clean ~= text then
            self._filtering = true
            box.Text = clean
            self._filtering = false
        end

        if settings.Trigger == "Change" then
            self:_Commit(clean)
        end
    end)

    box.Focused:Connect(function()
        TweenToken(boxStroke, "Color", "Accent")
    end)

    box.FocusLost:Connect(function(enterPressed)
        TweenToken(boxStroke, "Color", "Stroke")

        local accept = settings.Trigger ~= "Enter" or enterPressed
        if not (accept and self:_Commit(box.Text)) then
            self:_ShowValue()
        end
    end)

    box.MouseEnter:Connect(function()
        self:_SetHover(true)
    end)

    box.MouseLeave:Connect(function()
        self:_SetHover(false)
    end)

    -- Clicking the title area focuses the box.
    self.Hit.MouseButton1Click:Connect(function()
        box:CaptureFocus()
    end)

    self:_Finish()
    return self
end

function Input:_Sanitize(text)
    if self.Settings.Numeric then
        text = SanitizeNumber(text)
    end

    local limit = self.Settings.MaxLength
    if limit > 0 and #text > limit then
        text = string.sub(text, 1, limit)
    end

    return text
end

function Input:_ShowValue()
    self._filtering = true
    self.Box.Text = tostring(self.Value)
    self._filtering = false
end

-- Returns false when the text is not a valid value yet (like "-" for a number).
function Input:_Commit(text)
    local value = text

    if self.Settings.Numeric then
        value = tonumber(text)

        if value == nil then
            return false
        end
    end

    if value ~= self.Value then
        self.Value = value
        Library.OptionChanged:Fire(self.Flag)
        self:_Call(self.Settings.Callback, value)
    end

    return true
end

function Input:SetValue(value, silent)
    if self.Settings.Numeric then
        value = tonumber(value)

        if value == nil then
            error("Input:SetValue expects a number for a numeric input", 2)
        end
    else
        value = tostring(value)
    end

    self.Value = value
    self:_ShowValue()
    Library.OptionChanged:Fire(self.Flag)

    if not silent then
        self:_Call(self.Settings.Callback, value)
    end
end

function Input:GetValue()
    return self.Value
end

function Input:GetSaveData()
    return self.Value
end

function Input:LoadSaveData(data)
    if type(data) == "string" or type(data) == "number" then
        if self.Settings.Numeric and tonumber(data) == nil then
            return
        end

        self:SetValue(data)
    end
end

-- ----------------------------------------------------------------------------
-- Popup behavior shared by Dropdown and ColorPicker: the footer expands under
-- the header, and only one popup is open per window.
-- ----------------------------------------------------------------------------

local function PopupOpen(self)
    if self.Destroyed or self.IsOpen then
        return
    end

    self.IsOpen = true
    self._openToken = self._openToken + 1
    self.Window:_OpenPopup(self)

    self.Footer.Visible = true
    Tween(self.Footer, "Hover", { Size = self:_FooterSize(self:_PopupHeight()) })

    if self.Arrow then
        Tween(self.Arrow, "Hover", { Rotation = -90 })
    end
end

local function PopupClose(self)
    if not self.IsOpen then
        return
    end

    self.IsOpen = false
    self._openToken = self._openToken + 1
    local token = self._openToken
    self.Window:_PopupClosed(self)

    Tween(self.Footer, "Hover", { Size = self:_FooterSize(0) })

    if self.Arrow then
        Tween(self.Arrow, "Hover", { Rotation = 90 })
    end

    task.delay(0.3, function()
        if token == self._openToken and not self.IsOpen and not self.Destroyed then
            self.Footer.Visible = false
        end
    end)
end

local function PopupToggle(self)
    if self.IsOpen then
        self:Close()
    else
        self:Open()
    end
end

-- ----------------------------------------------------------------------------
-- Dropdown (single or multi select)
-- ----------------------------------------------------------------------------

local Dropdown = setmetatable({}, { __index = Element })
Dropdown.__index = Dropdown
Dropdown.ClassName = "Dropdown"
Dropdown.Savable = true
Dropdown.Open = PopupOpen
Dropdown.Close = PopupClose
Dropdown.ToggleOpen = PopupToggle

local ROW_HEIGHT = 26

local DROPDOWN_SCHEMA = Merge(COMMON_SCHEMA, {
    Title = { "Dropdown", "string" },
    Options = { {}, "table" }, -- array of strings (copied, never modified)
    Default = { false, "boolean", "string", "table" }, -- a string, or an array when Multi
    Multi = { false, "boolean" },
    AllowNone = { false, "boolean" }, -- single select: clicking the chosen option clears it
    Placeholder = { "Select...", "string" },
    MaxVisible = { 6, "number" }, -- rows shown before the list scrolls
    Callback = { NOOP, "function" }, -- receives a string (single) or an array (multi)
})

function Dropdown.new(section, flag, settings)
    local options = {}
    for index, option in ipairs(settings.Options) do
        if type(option) ~= "string" then
            error(string.format("Dropdown '%s': Options[%d] must be a string", settings.Title, index), 3)
        end

        options[index] = option
    end

    local self = Element.new(Dropdown, section, flag, settings, {
        Interactive = true,
        Reserve = 160,
        Footer = 0,
        FooterFull = true,
    })

    self.Options = options
    self.Multi = settings.Multi
    self.Value = settings.Multi and {} or nil
    self.IsOpen = false

    self._known = {}
    self._selected = {}
    self._rows = {}
    self._openToken = 0

    self.ValueLabel = Create("TextLabel", {
        Name = "Value",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(130, 16),
        Font = Fonts.Regular,
        TextSize = Metrics.TextSmall + 1,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Theme = { TextColor3 = "TextMuted" },
        Parent = self.Card,
    })

    self.Arrow = Create("TextLabel", {
        Name = "Arrow",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(12, 18),
        Font = Fonts.Bold,
        TextSize = 18,
        Text = "›",
        Rotation = 90,
        Theme = { TextColor3 = "TextDim" },
        Parent = self.Card,
    })

    self:_PlaceControl(self.Arrow, Metrics.ElementPadding)
    self:_PlaceControl(self.ValueLabel, Metrics.ElementPadding + 18)
    self:_Fade(self.ValueLabel, "TextTransparency", 0)
    self:_Fade(self.Arrow, "TextTransparency", 0)

    self.List = Create("ScrollingFrame", {
        Name = "List",
        Size = UDim2.new(1, 0, 1, 0),
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        Theme = { BackgroundColor3 = "Surface", ScrollBarImageColor3 = "Stroke" },
        Parent = self.Footer,
    }, {
        Corner(6),
        Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
        Padding(4),
    })

    self.Hit.MouseButton1Click:Connect(function()
        self:ToggleOpen()
    end)

    self:_SetOptions(options)
    self:_RenderValue()
    self:_Finish()

    if settings.Default ~= false then
        self:SetValue(settings.Default)
    end

    return self
end

function Dropdown:_PopupHeight()
    local rows = math.max(1, math.min(#self.Options, self.Settings.MaxVisible))
    return rows * ROW_HEIGHT + 8
end

function Dropdown:_ComputeValue()
    if self.Multi then
        local list = {}

        for _, option in ipairs(self.Options) do
            if self._selected[option] then
                list[#list + 1] = option
            end
        end

        return list
    end

    for _, option in ipairs(self.Options) do
        if self._selected[option] then
            return option
        end
    end

    return nil
end

local function SameValue(a, b)
    if type(a) ~= "table" or type(b) ~= "table" then
        return a == b
    end

    if #a ~= #b then
        return false
    end

    for index = 1, #a do
        if a[index] ~= b[index] then
            return false
        end
    end

    return true
end

function Dropdown:_RenderRow(option)
    local row = self._rows[option]
    local selected = self._selected[option] == true

    row.Indicator.BackgroundTransparency = selected and 0 or 1
    Theme:Bind(row.Label, { TextColor3 = selected and "Accent" or "TextDim" })
end

function Dropdown:_RenderValue()
    local label = self.ValueLabel
    local text

    if self.Multi then
        text = #self.Value > 0 and table.concat(self.Value, ", ") or nil
    else
        text = self.Value
    end

    label.Text = text or self.Settings.Placeholder
    Theme:Bind(label, { TextColor3 = text and "Text" or "TextMuted" })
end

-- Rebuilds the option rows (also used by SetOptions).
function Dropdown:_SetOptions(options)
    for _, row in pairs(self._rows) do
        row.Frame:Destroy()
    end

    self._rows = {}
    self._known = {}
    self.Options = options

    for index, option in ipairs(options) do
        self._known[option] = true

        local indicator = Create("Frame", {
            Name = "Indicator",
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 2, 0.5, 0),
            Size = UDim2.fromOffset(3, 14),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Theme = { BackgroundColor3 = "Accent" },
        }, {
            Corner(2),
        })

        local label = Create("TextLabel", {
            Name = "Label",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 0),
            Size = UDim2.new(1, -20, 1, 0),
            Font = Fonts.Medium,
            TextSize = Metrics.TextSmall + 1,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = option,
            Theme = { TextColor3 = "TextDim" },
        })

        local frame = Create("TextButton", {
            Name = option,
            Text = "",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
            LayoutOrder = index,
            Theme = { BackgroundColor3 = "ElementHover" },
            Parent = self.List,
        }, {
            Corner(5),
            indicator,
            label,
        })

        frame.MouseEnter:Connect(function()
            Tween(frame, "Hover", { BackgroundTransparency = 0.5 })
        end)

        frame.MouseLeave:Connect(function()
            Tween(frame, "Hover", { BackgroundTransparency = 1 })
        end)

        frame.MouseButton1Click:Connect(function()
            self:_Pick(option)
        end)

        self._rows[option] = { Frame = frame, Label = label, Indicator = indicator }
        self:_RenderRow(option)
    end

    if self.IsOpen then
        Tween(self.Footer, "Hover", { Size = self:_FooterSize(self:_PopupHeight()) })
    end
end

-- Applies self._selected: recomputes the value, redraws, fires the callback if
-- the value actually changed.
function Dropdown:_Commit(silent)
    local previous = self.Value
    local value = self:_ComputeValue()

    for option in pairs(self._rows) do
        self:_RenderRow(option)
    end

    self.Value = value
    self:_RenderValue()

    if SameValue(previous, value) then
        return
    end

    Library.OptionChanged:Fire(self.Flag)

    if not silent then
        self:_Call(self.Settings.Callback, value)
    end
end

function Dropdown:_Pick(option)
    if self.Multi then
        self._selected[option] = not self._selected[option] or nil
        self:_Commit()
        return
    end

    if self._selected[option] then
        if not self.Settings.AllowNone then
            self:Close()
            return
        end

        self._selected = {}
    else
        self._selected = { [option] = true }
    end

    self:_Commit()
    self:Close()
end

-- Single: a string. Multi: an array of strings. Unknown options are ignored.
function Dropdown:SetValue(value, silent)
    local selected = {}

    if self.Multi then
        if type(value) == "string" then
            value = { value }
        end

        if type(value) == "table" then
            for _, option in ipairs(value) do
                if self._known[option] then
                    selected[option] = true
                end
            end
        end
    else
        if type(value) == "table" then
            value = value[1]
        end

        if type(value) == "string" then
            -- An option that does not exist changes nothing (nil / false clears).
            if not self._known[value] then
                return
            end

            selected[value] = true
        end
    end

    self._selected = selected
    self:_Commit(silent)
end

function Dropdown:GetValue()
    return self.Value
end

-- Replaces the option list. Selected options that no longer exist are dropped.
function Dropdown:SetOptions(list)
    if type(list) ~= "table" then
        error("Dropdown:SetOptions expects an array of strings", 2)
    end

    local options = {}
    for index, option in ipairs(list) do
        if type(option) ~= "string" then
            error(string.format("Dropdown:SetOptions: item %d must be a string", index), 2)
        end

        options[index] = option
    end

    self:_SetOptions(options)

    for option in pairs(self._selected) do
        if not self._known[option] then
            self._selected[option] = nil
        end
    end

    self:_Commit()
end

-- A cleared single-select saves as false (JSON has no way to keep a missing
-- value), so loading a config can clear the dropdown again.
function Dropdown:GetSaveData()
    if self.Value == nil then
        return false
    end

    return self.Value
end

function Dropdown:LoadSaveData(data)
    if type(data) == "string" or type(data) == "table" then
        self:SetValue(data)
    elseif data == false then
        self:SetValue(nil)
    end
end

function Dropdown:Destroy()
    self.Window:_PopupClosed(self)
    Element.Destroy(self)
end

-- ----------------------------------------------------------------------------
-- Keybind. One shared listener serves every keybind. Mode "Toggle" flips on
-- each press, "Hold" is active while the key is down. Give it a Target (the
-- flag of a Toggle or a Button) and it drives that element directly.
-- ----------------------------------------------------------------------------

local Keybind = setmetatable({}, { __index = Element })
Keybind.__index = Keybind
Keybind.ClassName = "Keybind"
Keybind.Savable = true

local MOUSE_KEYS = { MouseButton2 = true, MouseButton3 = true }
local KEYBIND_MODES = { Toggle = true, Hold = true }

local KEYBIND_SCHEMA = Merge(COMMON_SCHEMA, {
    Title = { "Keybind", "string" },
    Default = { "None", "string" }, -- a KeyCode name ("F", "RightShift") or MouseButton2 / MouseButton3
    Mode = { "Toggle", "string" },
    Target = { false, "boolean", "string" },
    Callback = { NOOP, "function" }, -- receives the active state (true / false)
    OnBind = { NOOP, "function" }, -- runs when the key is rebound (receives the key name)
})

local Keybinds = { Active = {}, Hooked = false, Capturing = nil }

-- "F" -> Enum.KeyCode.F, "MouseButton2" -> Enum.UserInputType.MouseButton2.
-- Returns nil for "None" and for names that do not exist.
local function ResolveKey(name)
    if name == "None" or name == "" then
        return nil, false
    end

    if MOUSE_KEYS[name] then
        return Enum.UserInputType[name], true
    end

    local ok, key = pcall(function()
        return Enum.KeyCode[name]
    end)

    if ok and key then
        return key, false
    end

    return nil, false
end

local function DispatchKey(input, pressed)
    if Keybinds.Capturing or UserInputService:GetFocusedTextBox() then
        return
    end

    local matches = {}
    for keybind in pairs(Keybinds.Active) do
        if keybind:_Matches(input) then
            matches[#matches + 1] = keybind
        end
    end

    for _, keybind in ipairs(matches) do
        keybind:_OnKey(pressed)
    end
end

local function HookKeybinds()
    if Keybinds.Hooked then
        return
    end
    Keybinds.Hooked = true

    Library:Connect(UserInputService.InputBegan, function(input)
        DispatchKey(input, true)
    end)

    Library:Connect(UserInputService.InputEnded, function(input)
        DispatchKey(input, false)
    end)
end

function Keybind.new(section, flag, settings)
    if not KEYBIND_MODES[settings.Mode] then
        error(string.format("Keybind '%s': Mode must be Toggle or Hold", settings.Title), 3)
    end

    local self = Element.new(Keybind, section, flag, settings, {
        Interactive = true,
        Reserve = 110,
    })

    self.Mode = settings.Mode
    self.Target = settings.Target or nil
    self.State = false
    self.Value = "None"
    self._key = nil
    self._isMouse = false

    local chipLabel = Create("TextLabel", {
        Name = "Label",
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = Fonts.Medium,
        TextSize = Metrics.TextSmall + 1,
        Text = "None",
        Theme = { TextColor3 = "TextDim" },
    })

    local chipStroke = Stroke("Stroke", 1, Metrics.StrokeTransparency)

    local chip = Create("Frame", {
        Name = "Chip",
        Size = UDim2.fromOffset(0, 24),
        AutomaticSize = Enum.AutomaticSize.X,
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = self.Card,
    }, {
        Corner(6),
        chipStroke,
        Padding(0, 10),
        Create("UISizeConstraint", { MinSize = Vector2.new(48, 24) }),
        chipLabel,
    })

    self.Chip = chip
    self.ChipLabel = chipLabel
    self:_PlaceControl(chip, Metrics.ElementPadding)
    self:_Fade(chip, "BackgroundTransparency", 0)
    self:_Fade(chipStroke, "Transparency", Metrics.StrokeTransparency)
    self:_Fade(chipLabel, "TextTransparency", 0)

    self.Hit.MouseButton1Click:Connect(function()
        self:_BeginCapture()
    end)

    HookKeybinds()
    Keybinds.Active[self] = true
    self._janitor:Add(function()
        Keybinds.Active[self] = nil
        self:_EndCapture()
    end)

    self:_SetKey(settings.Default)
    self:_Finish()
    self._ready = true -- from here on a rebind runs OnBind
    return self
end

function Keybind:_SetKey(name)
    local key, isMouse = ResolveKey(name)

    if key == nil and name ~= "None" and name ~= "" then
        Log(string.format("Keybind '%s': unknown key '%s'", self.Title, tostring(name)))
        name = "None"
    end

    local previous = self.Value

    self._key = key
    self._isMouse = isMouse
    self.Value = key and name or "None"
    self.ChipLabel.Text = self.Value
    Library.OptionChanged:Fire(self.Flag)

    if self._ready and self.Value ~= previous then
        self:_Call(self.Settings.OnBind, self.Value)
    end
end

function Keybind:_Matches(input)
    local key = self._key

    if key == nil then
        return false
    end

    if self._isMouse then
        return input.UserInputType == key
    end

    return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key
end

-- The element this keybind drives, if any.
function Keybind:_GetTarget()
    return self.Target and Library.Options[self.Target] or nil
end

function Keybind:_OnKey(pressed)
    if self.Mode == "Toggle" then
        if pressed then
            -- Flip whatever the target toggle currently shows, so a toggle
            -- changed by hand never leaves the keybind out of sync.
            local current = self.State
            local target = self:_GetTarget()

            if target and target.Class == "Toggle" then
                current = target.Value
            end

            self:_Activate(not current)
        end
    else
        self:_Activate(pressed)
    end
end

function Keybind:_Activate(state)
    self.State = state
    Library.OptionChanged:Fire(self.Flag)

    local target = self:_GetTarget()
    if target then
        if target.Class == "Toggle" then
            target:SetValue(state)
        elseif target.Class == "Button" and state then
            target:Fire()
        end
    end

    self:_Call(self.Settings.Callback, state)
end

-- Waits for the next key: Escape cancels, Backspace / Delete clears the bind.
function Keybind:_BeginCapture()
    if Keybinds.Capturing == self or self.Destroyed then
        return
    end

    if Keybinds.Capturing then
        Keybinds.Capturing:_EndCapture()
    end

    Keybinds.Capturing = self
    self.ChipLabel.Text = "..."

    self._capture = UserInputService.InputBegan:Connect(function(input)
        local inputType = input.UserInputType
        local name

        if inputType == Enum.UserInputType.Keyboard then
            local code = input.KeyCode

            if code == Enum.KeyCode.Escape then
                self:_EndCapture()
                return
            end

            if code == Enum.KeyCode.Backspace or code == Enum.KeyCode.Delete then
                name = "None"
            else
                name = code.Name
            end
        elseif MOUSE_KEYS[inputType.Name] then
            name = inputType.Name
        elseif inputType == Enum.UserInputType.MouseButton1 then
            self:_EndCapture()
            return
        else
            return
        end

        self:_SetKey(name)
        self:_EndCapture()
    end)
end

function Keybind:_EndCapture()
    if self._capture then
        self._capture:Disconnect()
        self._capture = nil
    end

    if Keybinds.Capturing == self then
        Keybinds.Capturing = nil
    end

    if not self.Destroyed then
        self.ChipLabel.Text = self.Value
    end
end

function Keybind:SetValue(name)
    self:_SetKey(name)
end

function Keybind:SetMode(mode)
    if not KEYBIND_MODES[mode] then
        error("Keybind:SetMode expects Toggle or Hold", 2)
    end

    self.Mode = mode
    self.Settings.Mode = mode
end

function Keybind:GetState()
    return self.State
end

function Keybind:GetSaveData()
    return { Key = self.Value, Mode = self.Mode }
end

function Keybind:LoadSaveData(data)
    if type(data) ~= "table" then
        return
    end

    if KEYBIND_MODES[data.Mode] then
        self:SetMode(data.Mode)
    end

    if type(data.Key) == "string" then
        self:_SetKey(data.Key)
    end
end

-- ----------------------------------------------------------------------------
-- ToggleKeybind: a toggle with its own hotkey, in one element. The switch sits
-- where a toggle's does; the key chip sits to its left. Pressing the key flips
-- the switch, clicking the chip rebinds it (Escape cancels, Backspace clears).
-- ----------------------------------------------------------------------------

local ToggleKeybind = setmetatable({}, { __index = Toggle })
ToggleKeybind.__index = ToggleKeybind
ToggleKeybind.ClassName = "ToggleKeybind"
ToggleKeybind.Savable = true

local CHIP_MIN = 40
local CHIP_MAX = 64
local CHIP_GAP = 8
ToggleKeybind.ExtraReserve = CHIP_MAX + CHIP_GAP

local TOGGLEKEYBIND_SCHEMA = Merge(TOGGLE_SCHEMA, {
    Title = { "Toggle", "string" },
    Key = { "None", "string" }, -- a KeyCode name ("F", "RightShift") or MouseButton2 / MouseButton3
    OnBind = { NOOP, "function" }, -- runs when the key is rebound (receives the key name)
})

function ToggleKeybind.new(section, flag, settings)
    return Toggle.new(section, flag, settings, ToggleKeybind)
end

-- Called by Toggle.new before the element plays in.
function ToggleKeybind:_BuildExtras()
    local chipLabel = Create("TextLabel", {
        Name = "Label",
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Font = Fonts.Medium,
        TextSize = Metrics.TextSmall + 1,
        Text = "None",
        Theme = { TextColor3 = "TextDim" },
    })

    local chipStroke = Stroke("Stroke", 1, Metrics.StrokeTransparency)

    -- A button, so a click on the chip rebinds instead of flipping the switch.
    local chip = Create("TextButton", {
        Name = "Chip",
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromOffset(0, 22),
        AutomaticSize = Enum.AutomaticSize.X,
        ClipsDescendants = true,
        BorderSizePixel = 0,
        ZIndex = 5,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = self.Card,
    }, {
        Corner(6),
        chipStroke,
        Padding(0, 8),
        Create("UISizeConstraint", { MinSize = Vector2.new(CHIP_MIN, 22), MaxSize = Vector2.new(CHIP_MAX, 22) }),
        chipLabel,
    })

    self.Chip = chip
    self.ChipLabel = chipLabel
    self.Key = "None"
    self._key = nil
    self._isMouse = false

    self:_PlaceControl(chip, Metrics.ElementPadding + TRACK_WIDTH + CHIP_GAP)
    self:_Fade(chip, "BackgroundTransparency", 0)
    self:_Fade(chipStroke, "Transparency", Metrics.StrokeTransparency)
    self:_Fade(chipLabel, "TextTransparency", 0)

    chip.MouseButton1Click:Connect(function()
        self:_BeginCapture()
    end)

    HookKeybinds()
    Keybinds.Active[self] = true
    self._janitor:Add(function()
        Keybinds.Active[self] = nil
        self:_EndCapture()
    end)

    self:_SetKey(self.Settings.Key)
    self._ready = true -- from here on a rebind runs OnBind
end

function ToggleKeybind:_SetKey(name)
    local key, isMouse = ResolveKey(name)

    if key == nil and name ~= "None" and name ~= "" then
        Log(string.format("ToggleKeybind '%s': unknown key '%s'", self.Title, tostring(name)))
        name = "None"
    end

    local previous = self.Key

    self._key = key
    self._isMouse = isMouse
    self.Key = key and name or "None"
    self.ChipLabel.Text = self.Key
    Library.OptionChanged:Fire(self.Flag)

    if self._ready and self.Key ~= previous then
        self:_Call(self.Settings.OnBind, self.Key)
    end
end

-- The shared key listener asks every active keybind these two questions.
ToggleKeybind._Matches = Keybind._Matches

function ToggleKeybind:_OnKey(pressed)
    if pressed then
        self:Toggle()
    end
end

-- Waits for the next key: Escape cancels, Backspace / Delete clears the bind.
function ToggleKeybind:_BeginCapture()
    if Keybinds.Capturing == self or self.Destroyed then
        return
    end

    if Keybinds.Capturing then
        Keybinds.Capturing:_EndCapture()
    end

    Keybinds.Capturing = self
    self.ChipLabel.Text = "..."

    self._capture = UserInputService.InputBegan:Connect(function(input)
        local inputType = input.UserInputType
        local name

        if inputType == Enum.UserInputType.Keyboard then
            local code = input.KeyCode

            if code == Enum.KeyCode.Escape then
                self:_EndCapture()
                return
            end

            name = (code == Enum.KeyCode.Backspace or code == Enum.KeyCode.Delete) and "None" or code.Name
        elseif MOUSE_KEYS[inputType.Name] then
            name = inputType.Name
        elseif inputType == Enum.UserInputType.MouseButton1 then
            self:_EndCapture()
            return
        else
            return
        end

        self:_SetKey(name)
        self:_EndCapture()
    end)
end

function ToggleKeybind:_EndCapture()
    if self._capture then
        self._capture:Disconnect()
        self._capture = nil
    end

    if Keybinds.Capturing == self then
        Keybinds.Capturing = nil
    end

    if not self.Destroyed then
        self.ChipLabel.Text = self.Key
    end
end

function ToggleKeybind:SetKey(name)
    self:_SetKey(name)
end

function ToggleKeybind:GetKey()
    return self.Key
end

function ToggleKeybind:GetSaveData()
    return { Value = self.Value, Key = self.Key }
end

function ToggleKeybind:LoadSaveData(data)
    if type(data) ~= "table" then
        return
    end

    if type(data.Key) == "string" then
        self:_SetKey(data.Key)
    end

    if type(data.Value) == "boolean" then
        self:SetValue(data.Value)
    end
end


local Tweens = {
    Show = TweenInfo.new(0.7, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
    Hover = TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
    Fade = TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
    Flash = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
    Fill = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
}

-- Plays a tween and returns it. `info` is a preset name ("Show", "Hover",
-- "Fade", "Flash", "Fill") or any TweenInfo. A new tween on a property cancels
-- the previous one on that property, so hover in/out never fight each other.
local function Tween(instance, info, properties)
    local tweenInfo = info

    if type(info) == "string" then
        tweenInfo = Tweens[info]
        if not tweenInfo then
            error(string.format("Unknown tween preset '%s'", info), 2)
        end
    end

    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()

    return tween
end

-- Tweens a color property to a theme token AND keeps it bound to that token,
-- so a later theme switch still recolors it correctly.
--     TweenToken(card, "BackgroundColor3", "ElementHover")
local function TweenToken(instance, property, token, info)
    Theme:Bind(instance, { [property] = token }, true)
    return Tween(instance, info or "Hover", { [property] = Theme.Tokens[token] })
end

-- Turns a gui object around its center forever (one full turn per `seconds`).
-- One looping tween, so it costs nothing per frame in Lua.
local function Spin(instance, seconds)
    instance.Rotation = 0

    local tween = TweenService:Create(
        instance,
        TweenInfo.new(seconds, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
        { Rotation = 360 }
    )

    tween:Play()
    return tween
end

-- Gently breathes the size of a gui object forever. One looping tween.
local function Pulse(instance, seconds, amount)
    seconds = tonumber(seconds) or 1.2
    amount  = tonumber(amount)  or 0.16

    local base = instance.Size
    local function scaled(mult)
        return UDim2.new(
            base.X.Scale * mult, base.X.Offset * mult,
            base.Y.Scale * mult, base.Y.Offset * mult
        )
    end

    local big   = scaled(1 + amount)
    local small = scaled(1 + amount * 0.5)

    instance.Size = base

    task.spawn(function()
        while instance.Parent do
            -- lub
            TweenService:Create(instance, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = big }):Play()
            task.wait(0.10)
            TweenService:Create(instance, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.In),  { Size = base }):Play()
            task.wait(0.10)

            -- dub
            TweenService:Create(instance, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = small }):Play()
            task.wait(0.08)
            TweenService:Create(instance, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.In),  { Size = base }):Play()

            -- rest
            task.wait(math.max(0.1, seconds - 0.48))
        end
    end)
end

-- Builds an instance from a property table. Parent is applied LAST so the
-- engine only lays the instance out once.
--     Create("Frame", {
--         Name = "Card",
--         Size = UDim2.new(1, 0, 0, 38),
--         Theme = { BackgroundColor3 = "Element" },   -- live-bound to the theme
--         Parent = holder,
--     }, {
--         Corner(8),
--         Stroke("Stroke"),
--     })
local function Create(className, properties, children)
    local instance = Instance.new(className)
    local parent
    local themeMap

    for property, value in pairs(properties or {}) do
        if property == "Parent" then
            parent = value
        elseif property == "Theme" then
            themeMap = value
        else
            instance[property] = value
        end
    end

    if themeMap then
        Theme:Bind(instance, themeMap)
    end

    if children then
        for _, child in ipairs(children) do
            child.Parent = instance
        end
    end

    instance.Parent = parent
    return instance
end

local function Corner(radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or Theme.Metrics.Radius),
    })
end

-- Themed border. `token` is the color token (default "Stroke").
local function Stroke(token, thickness, transparency)
    return Create("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Thickness = thickness or Theme.Metrics.StrokeThickness,
        Transparency = transparency or 0,
        Theme = { Color = token or "Stroke" },
    })
end

-- Padding(10) = 10 on every side, Padding(6, 12) = 6 vertical, 12 horizontal.
local function Padding(vertical, horizontal)
    vertical = vertical or Theme.Metrics.Padding
    horizontal = horizontal or vertical

    return Create("UIPadding", {
        PaddingTop = UDim.new(0, vertical),
        PaddingBottom = UDim.new(0, vertical),
        PaddingLeft = UDim.new(0, horizontal),
        PaddingRight = UDim.new(0, horizontal),
    })
end

-- True when an input is a primary press (left mouse button or a touch).
local function IsPress(input)
    local inputType = input.UserInputType
    return inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch
end

-- Call from an InputBegan handler to start a drag. `onMove(position)` runs for
-- every pointer move until the press ends. The listener only exists while
-- dragging. Pass `immediate` to also run onMove at the press position, and a
-- ScrollingFrame to lock its scrolling for the duration (touch drags).
local function BeginDrag(input, onMove, immediate, scrollFrame)
    if scrollFrame then
        scrollFrame.ScrollingEnabled = false
    end

    if immediate then
        onMove(input.Position)
    end

    local moveConnection, endConnection

    moveConnection = UserInputService.InputChanged:Connect(function(changed)
        local changedType = changed.UserInputType

        if changedType == Enum.UserInputType.MouseMovement or changedType == Enum.UserInputType.Touch then
            onMove(changed.Position)
        end
    end)

    endConnection = input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            moveConnection:Disconnect()
            endConnection:Disconnect()

            if scrollFrame then
                scrollFrame.ScrollingEnabled = true
            end
        end
    end)
end


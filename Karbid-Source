    local element = Divider.new(self, ReadSettings("Divider", "Divider", DIVIDER_SCHEMA, given, 3))
    self.Elements[element] = true
    self.Window:_LoadWork()
    return element
end

function Section:Destroy()
    if self.Destroyed then
        return
    end
    self.Destroyed = true

    local elements = {}
    for element in pairs(self.Elements) do
        elements[#elements + 1] = element
    end

    for _, element in ipairs(elements) do
        element:Destroy()
    end

    self.Tab.Sections[self] = nil

    for index, candidate in ipairs(self.Tab._ordered) do
        if candidate == self then
            table.remove(self.Tab._ordered, index)
            break
        end
    end

    self.Frame:Destroy()

    if self.Panel then
        self.Panel:Destroy()
        self.Placeholder:Destroy()
    end

    self.Tab:Rearrange()
end

-- ----------------------------------------------------------------------------
-- Tab: one entry in the sidebar and one scrolling page of sections.
-- ----------------------------------------------------------------------------

local Tab = {}
Tab.__index = Tab

local TWO_COLUMN_WIDTH = 580 -- a tab shows two columns once its page is this wide
local HEADING_HEIGHT = 28 -- the tab name above the columns
local POPPED_HEIGHT = 40 -- the stand-in left behind by a popped-out section

local TAB_SCHEMA = {
    Icon = { "", "string", "number" },
}

function Tab.new(window, title, settings)
    local hasIcon = settings.Icon ~= ""

    window._tabCount = window._tabCount + 1

    local self = setmetatable({
        Window = window,
        Title = title,
        Settings = settings,
        Sections = {},
        Selected = false,
        Destroyed = false,
        _order = 0,
    }, Tab)

    local indicator = Create("Frame", {
        Name = "Indicator",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, -9, 0.5, 0),
        Size = UDim2.new(0, 3, 0, 18),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Accent" },
    }, {
        Corner(2),
    })

    -- The rail shows icons only. A tab without an icon shows its first letter.
    local label = Create("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Font = Fonts.Bold,
        TextSize = Metrics.TextBody + 2,
        Text = string.upper(string.sub(title, 1, 1)),
        Visible = not hasIcon,
        Theme = { TextColor3 = "TextDim" },
    })

    -- Accent ring around the selected tab.
    local ring = Stroke("Accent", 1.5, 1)
    ring.Name = "Ring"

    local button = Create("TextButton", {
        Name = title,
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(40, 40),
        LayoutOrder = window._tabCount,
        Theme = { BackgroundColor3 = "Element" },
        Parent = window.TabList,
    }, {
        Corner(),
        ring,
        indicator,
        label,
    })

    if hasIcon then
        local icon = Create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.fromOffset(20, 20),
            Theme = { ImageColor3 = "TextDim" },
            Parent = button,
        })

        Icons:Apply(icon, settings.Icon)
        self.IconImage = icon
    end

    self.Button = button
    self.Indicator = indicator
    self.Label = label
    self.Ring = ring

    -- The page holds the tab name and, below it, two scrolling columns (Left
    -- and Right). With a narrow window only Left is used; once the page is wide
    -- enough both show and Tab:Rearrange spreads the sections over them.
    local pad = Metrics.Padding
    local top = pad + HEADING_HEIGHT

    local heading = Create("TextLabel", {
        Name = "Heading",
        BackgroundTransparency = 1,
        LayoutOrder = 0,
        Position = UDim2.new(0, pad, 0, pad),
        Size = UDim2.new(1, -pad * 2, 0, HEADING_HEIGHT),
        Font = Fonts.Bold,
        TextSize = Metrics.TextTitle + 2,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = title,
        Theme = { TextColor3 = "Text" },
    })

    self.Page = Create("Frame", {
        Name = title,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        Parent = window.Content,
    }, {
        heading,
    })

    local function column(name)
        local padding = Create("UIPadding", {
            PaddingLeft = UDim.new(0, pad),
            PaddingRight = UDim.new(0, pad),
            PaddingTop = UDim.new(0, 6),
            PaddingBottom = UDim.new(0, pad),
        })

        local frame = Create("ScrollingFrame", {
            Name = name,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, top),
            Size = UDim2.new(1, 0, 1, -top),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Theme = { ScrollBarImageColor3 = "Stroke" },
            Parent = self.Page,
        }, {
            Create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, pad + 2),
            }),
            padding,
        })

        return frame, padding
    end

    local left, leftPadding = column("Left")
    local right, rightPadding = column("Right")
    right.Visible = false

    self.Heading = heading
    self.Columns = { left, right }
    self.ColumnMode = 1 -- 1 or 2 columns showing
    self._columnTop = top
    self._leftPadding = leftPadding
    self._rightPadding = rightPadding
    self._ordered = {} -- sections in creation order

    -- Drags (sliders, color pickers) switch scrolling off in both columns.
    self.Scroll = setmetatable({}, {
        __newindex = function(_, key, value)
            if key == "ScrollingEnabled" then
                left.ScrollingEnabled = value
                right.ScrollingEnabled = value
            end
        end,
    })

    self.Page:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        self:_UpdateColumns()
    end)

    -- The rail has no text, so the tab name shows as a tooltip.
    button.MouseEnter:Connect(function()
        window:_TooltipShow(title)

        if not self.Selected then
            Tween(button, "Hover", { BackgroundTransparency = 0.5 })
        end
    end)

    button.MouseMoved:Connect(function()
        window:_TooltipMove()
    end)

    button.MouseLeave:Connect(function()
        window:_TooltipHide()

        if not self.Selected then
            Tween(button, "Hover", { BackgroundTransparency = 1 })
        end
    end)

    button.MouseButton1Click:Connect(function()
        self:Select()
    end)

    return self
end

function Tab:_NextOrder()
    self._order = self._order + 1
    return self._order
end

-- One column when the page is narrow, two when it is wide enough.
function Tab:_UpdateColumns()
    local mode = (not self.SingleColumn and self.Page.AbsoluteSize.X >= TWO_COLUMN_WIDTH) and 2 or 1

    if mode == self.ColumnMode then
        return
    end

    self.ColumnMode = mode

    local pad = Metrics.Padding
    local top = self._columnTop
    local two = mode == 2
    local left, right = self.Columns[1], self.Columns[2]

    left.Size = UDim2.new(two and 0.5 or 1, 0, 1, -top)
    right.Position = UDim2.new(0.5, 0, 0, top)
    right.Size = UDim2.new(0.5, 0, 1, -top)
    right.Visible = two
    self._leftPadding.PaddingRight = UDim.new(0, two and pad / 2 or pad)
    self._rightPadding.PaddingLeft = UDim.new(0, pad / 2)

    -- Sizes are known by now, so the sections are placed by their real heights.
    self:Rearrange(true)
end

-- The height a section takes, measured when it has been laid out, else a
-- rough estimate (title row + one row per element, none when collapsed).
function Tab:_SectionHeight(section, measured)
    if measured then
        local height = section.Frame.AbsoluteSize.Y

        if height > 0 then
            return height
        end
    end

    local height = 22

    if not section.Collapsed then
        for element in pairs(section.Elements) do
            if element:IsVisible() then
                height = height + Metrics.ElementHeight + Metrics.Gap
            end
        end
    end

    return height
end

-- Places every section. One column: all in Left, in creation order. Two
-- columns: each section goes under the shorter column (ties go left), so the
-- columns end up about as tall as each other. A section with Column = "Left" or
-- "Right" stays where it was told to. Creation order is kept inside a column.
function Tab:Rearrange(measured)
    local two = self.ColumnMode == 2
    local heights = { 0, 0 }

    for index, section in ipairs(self._ordered) do
        local side = 1

        if two then
            local wanted = section.Settings.Column

            if wanted == "Right" then
                side = 2
            elseif wanted == "Auto" then
                side = heights[2] < heights[1] and 2 or 1
            end
        end

        local target = self.Columns[side]
        local frame = section.PoppedOut and section.Placeholder or section.Frame

        if frame.Parent ~= target then
            frame.Parent = target
        end

        frame.LayoutOrder = index
        heights[side] = heights[side] + (section.PoppedOut and POPPED_HEIGHT or self:_SectionHeight(section, measured)) + Metrics.Gap
    end
end

function Tab:_SetActive(active)
    self.Selected = active
    self.Page.Visible = active

    Tween(self.Button, "Hover", { BackgroundTransparency = active and 0 or 1 })
    Tween(self.Indicator, "Hover", { BackgroundTransparency = active and 0 or 1 })
    Tween(self.Ring, "Hover", { Transparency = active and 0.35 or 1 })
    TweenToken(self.Label, "TextColor3", active and "Text" or "TextDim")

    if self.IconImage then
        TweenToken(self.IconImage, "ImageColor3", active and "Accent" or "TextDim")
    end
end

function Tab:Select()
    self.Window:_SelectTab(self)
end

function Tab:AddSection(title, settings)
    if type(title) ~= "string" or title == "" then
        error("AddSection expects a title", 2)
    end

    local section = Section.new(self, title, ReadSettings("Section", title, SECTION_SCHEMA, settings, 3))
    self.Sections[section] = true
    self._ordered[#self._ordered + 1] = section
    self:Rearrange()
    self.Window:_LoadWork()
    return section
end

function Tab:Destroy()
    if self.Destroyed then
        return
    end
    self.Destroyed = true

    local sections = {}
    for section in pairs(self.Sections) do
        sections[#sections + 1] = section
    end

    for _, section in ipairs(sections) do
        section:Destroy()
    end

    self.Window:_RemoveTab(self)
    self.Page:Destroy()
    self.Button:Destroy()
end


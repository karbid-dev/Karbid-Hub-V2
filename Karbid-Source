    ProtectGui(gui)
    Library:Track(gui)

    self.Holder = Create("Frame", {
        Name = "Holder",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.new(0, NOTIFY_WIDTH, 1, -32),
        Parent = gui,
    }, {
        Create("UIListLayout", {

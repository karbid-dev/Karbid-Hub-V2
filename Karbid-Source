-- The strip the engine keeps for its own top bar. Windows, panels and the
-- island stay out of it. Returns top, left, right, bottom (pixels).
local function GuiInset()
    local ok, topLeft, bottomRight = pcall(function()
        return GuiService:GetGuiInset()
    end)

    if ok and typeof(topLeft) == "Vector2" and typeof(bottomRight) == "Vector2" then
        return topLeft.Y, topLeft.X, bottomRight.X, bottomRight.Y
    end

    return 0, 0, 0, 0
end

-- Where the gui's own (0, 0) sits on the screen. A gui nested in the engine's
-- own UI can start below its top bar already (then this is the bar's height),
-- so positions are worked out from this instead of assumed. It is read from a
-- tiny frame at (0, 0): the engine lays every instance out, the gui itself
-- does not always report it.
local function AddOriginProbe(gui)
    Create("Frame", {
        Name = "Origin",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(0, 0),
        Parent = gui,
    })
end

local function GuiOrigin(gui)
    local ok, position = pcall(function()
        local probe = gui:FindFirstChild("Origin")
        return (probe or gui).AbsolutePosition
    end)

    return ok and typeof(position) == "Vector2" and position.Y or 0
end

local function ProtectGui(gui)
    if type(syn) == "table" and type(syn.protect_gui) == "function" then
        pcall(syn.protect_gui, gui)
    end
end

-- A control can be "active" (the transparency button while it is on): it keeps
-- the accent color. ControlTint[button](token) recolors the glyph and icon.
local ControlActive = setmetatable({}, { __mode = "k" })
local ControlTint = setmetatable({}, { __mode = "k" })

local function SetControlActive(button, active)
    ControlActive[button] = active or nil
    ControlTint[button](active and "Accent" or "TextDim")
end

-- Shows an icon in a control button. The text glyph stays until the icon has
-- loaded (and for good when icons are unavailable).
local function SetControlIcon(button, icon, glyph)
    local image = button:FindFirstChild("Icon")

    button.Text = glyph

    if not image then
        return
    end

    image.Visible = false
    Icons:Apply(image, icon)

    if image.Image and image.Image ~= "" then
        image.Visible = true
        button.Text = ""
    end
end

-- One of the small round buttons in the top bar. `icon` is an icon name; the
-- text `glyph` is the fallback.
local function ControlButton(parent, name, glyph, order, hoverToken, callback, icon)
    local button = Create("TextButton", {
        Name = name,
        Text = glyph,
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = order,
        Size = UDim2.fromOffset(28, 28),
        Font = Fonts.Bold,
        TextSize = 18,
        Theme = { BackgroundColor3 = hoverToken, TextColor3 = "TextDim" },
        Parent = parent,
    }, {
        Corner(6),
    })

    local image

    if icon then
        image = Create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(16, 16),
            Visible = false,
            Theme = { ImageColor3 = "TextDim" },
            Parent = button,
        })

        image:GetPropertyChangedSignal("Image"):Connect(function()
            if image.Image and image.Image ~= "" and image.Parent then
                image.Visible = true
                button.Text = ""
            end
        end)

        SetControlIcon(button, icon, glyph)
    end

    local function tint(token)
        TweenToken(button, "TextColor3", token)

        if image then
            TweenToken(image, "ImageColor3", token)
        end
    end

    ControlTint[button] = tint

    button.MouseEnter:Connect(function()
        Tween(button, "Hover", { BackgroundTransparency = 0 })
        tint("Text")
    end)

    button.MouseLeave:Connect(function()
        Tween(button, "Hover", { BackgroundTransparency = 1 })
        tint(ControlActive[button] and "Accent" or "TextDim")
    end)

    button.MouseButton1Click:Connect(callback)
    return button
end


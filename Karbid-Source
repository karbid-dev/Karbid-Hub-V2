    end

    local settings = ReadSettings("HomeTab", "Home", Home.Schema, options, 3)
    settings.ServerPageSize = math.clamp(math.floor(settings.ServerPageSize), 10, 100)
    settings.MaxServerPages = math.max(1, math.floor(settings.MaxServerPages))

    local tab = window:AddTab(settings.Title, { Icon = settings.Icon })

    -- Home always uses one column, even when the window is wide.
    -- (Tab:_UpdateColumns must read this flag, see the note below the code.)
    tab.SingleColumn = true

    -- One section holds the cards. Its header is hidden so the cards sit at the top.
    local section = tab:AddSection("Home", { Column = "Left", PopOut = false, Collapsible = false })
    section.Header.Visible = false

    local player = Players.LocalPlayer
    local busy = false
    local developerName = "Unknown"

    -- ------------------------------------------------------------------------
    -- Profile card
    -- ------------------------------------------------------------------------
    local scrolling = {}

    -- One loop for every tiled background, running only while Home is on screen.
    Library:Every(0, function(dt)
        if not tab.Page.Visible or not Library.Window or not Library.Window.Visible then
            return
        end

        for _, item in ipairs(scrolling) do
            item.x = (item.x + item.speedX * dt) % Home.TileSize
            item.y = (item.y + item.speedY * dt) % Home.TileSize
            item.image.Position = UDim2.fromOffset(-item.x, -item.y)
        end
    end)

    local profileCard = Home.Card(section.Container, "ProfileCard", 176, section:_NextOrder())
    Home.TiledBackground(profileCard, Home.ProfileBg, 12, 6, scrolling)

    Home.Text(
        profileCard, "Welcome", "Welcome Back", Fonts.Regular, Metrics.TextSmall,
        "TextDim", UDim2.fromOffset(16, 14), UDim2.new(1, -150, 0, 16)
    )

    local displayName = Home.Text(
        profileCard, "DisplayName", player.DisplayName, Fonts.Bold, Metrics.TextTitle + 2,

function Home.Copy(text)
    -- The same lookup order as the usual `if setclipboard then ... elseif toclipboard`.
    local setter = setclipboard or toclipboard or set_clipboard
    local clipboard = Clipboard or clipboard

    if not setter and type(clipboard) == "table" then
        setter = clipboard.set
    end

    if not setter then
        return false, "Clipboard is not available here."
    end

    local ok, err = pcall(setter, tostring(text))
    return ok, (not ok) and tostring(err) or nil
end

-- Copies `value` and tells the user. `failKind` is the notification type used
-- when the clipboard is not available.
function Home.CopyNotify(label, value, successText, failKind)
    local ok, err = Home.Copy(value)

    if ok then
        Home.Notify(label, successText, "Success")
    else
        Home.Notify(label, err, failKind or "Error")
    end
end

function Home.HttpGet(url)
    local ok, body = pcall(game.HttpGet, game, url)
    if ok and type(body) == "string" then
        return body
    end

    local requester = request or http_request or (syn and syn.request)

    if type(requester) == "function" then
        local okRequest, response = pcall(requester, { Url = url, Method = "GET" })

        if okRequest and type(response) == "table" then
            local success = response.Success
                or (type(response.StatusCode) == "number" and response.StatusCode < 300)

            if success and type(response.Body) == "string" then
                return response.Body
            end
        end
    end

    return nil, "HTTP is unavailable or the request failed."
end

-- Public servers for this place with room left, fewest players first.
function Home.FetchServers(placeId, pageSize, maxPages)
    local found = {}
    local cursor

    for _ = 1, maxPages do
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=%d",
            placeId,
            pageSize
        )

        if cursor then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local body, reason = Home.HttpGet(url)
        if not body then
            return nil, reason
        end

        local decoded, data = pcall(HttpService.JSONDecode, HttpService, body)
        if not decoded or type(data) ~= "table" or type(data.data) ~= "table" then
            return nil, "The server list could not be read."
        end

        for _, server in ipairs(data.data) do
            local playing = server.playing or 0
            local maxPlayers = server.maxPlayers or 0

            if server.id ~= game.JobId and playing < maxPlayers then
                found[#found + 1] = {
                    Id = server.id,
                    Players = playing,
                    MaxPlayers = maxPlayers,
                }
            end
        end

        cursor = data.nextPageCursor
        if not cursor then
            break
        end
    end

    table.sort(found, function(a, b)
        return a.Players < b.Players
    end)

    return found
end


-- ----------------------------------------------------------------------------
-- Notifications
--
--     Library:Notify({ Title = "Saved", Content = "Profile 'Main'", Type = "Success", Duration = 4 })
--     Library:Notify("Short message")
--
-- Type is Info, Success, Warning or Error. Duration 0 keeps the toast until it
-- is clicked. At most 5 are shown; the oldest makes room for a new one.
-- ----------------------------------------------------------------------------

local NOTIFY_WIDTH = 280
local NOTIFY_MAX = 5
local NOTIFY_OFFSCREEN = NOTIFY_WIDTH + 24

local NOTIFY_TYPES = {
    Info = "Info",
    Success = "Success",
    Warning = "Warning",
    Error = "Error",
}

local NOTIFY_SCHEMA = {
    Title = { "Notification", "string" },
    Content = { "", "string" },
    Type = { "Info", "string" },
    Duration = { 4, "number" }, -- seconds, 0 = until clicked
    Icon = { "", "string", "number" },
}

local Notifier = { Holder = nil, Active = {}, Order = 0 }

-- One shared ScreenGui, created on the first notification (so Notify works
-- before and without a window).

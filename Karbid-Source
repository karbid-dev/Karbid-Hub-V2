-- instance -> { Property = "TokenName" }. The table holds its instances
-- strongly: an instance nothing else refers to (a UIGradient or UIStroke made
-- inline, a divider line) would otherwise lose its binding once the engine
-- collected its Lua object, and stop following the theme. Destroyed UI is
-- dropped by a sweep (see Sweep) instead.
local bindings = {}
local bindCount = 0
local sweepQueued = false

-- Forgets instances that have been destroyed (they have no parent any more).
local function Sweep()
    sweepQueued = false

    for instance in pairs(bindings) do
        if instance.Parent == nil then
            bindings[instance] = nil
        end
    end
end

-- The second gradient color: the accent, darker. Gradients (primary button,
-- slider fill, the top bar line) stay in the accent's own color.
local function ShadeAccent(color)
    local hue, saturation, value = color:ToHSV()
    return Color3.fromHSV(hue, math.min(1, saturation), value * 0.38)
end

local function BuildGradient(tokens)
    tokens.Gradient = ColorSequence.new(tokens.Accent, tokens.AccentAlt)
end

local function Refresh()
    local tokens = Theme.Tokens

    Sweep()

    for instance, map in pairs(bindings) do
        for property, token in pairs(map) do
            instance[property] = tokens[token]
        end
    end

    Theme.Changed:Fire(Theme.Name)
end

-- Binds properties to tokens and applies them right away. Pass `deferApply`
-- when you are about to tween the property yourself (see TweenToken).
--     Theme:Bind(frame, { BackgroundColor3 = "Element" })
function Theme:Bind(instance, map, deferApply)
    local tokens = self.Tokens
    local bound = bindings[instance]

    if not bound then
        bound = {}
        bindings[instance] = bound

        -- Every so often, once the new instances have found their parents,
        -- drop the ones that were destroyed.
        bindCount = bindCount + 1

        if bindCount % 512 == 0 and not sweepQueued then
            sweepQueued = true
            task.defer(Sweep)
        end
    end

    for property, token in pairs(map) do
        if tokens[token] == nil then
            error(string.format("Unknown theme token '%s'", tostring(token)), 2)
        end

        bound[property] = token

        if not deferApply then
            instance[property] = tokens[token]
        end
    end

    return instance
end

function Theme:Unbind(instance)
    bindings[instance] = nil
end

function Theme:Get(token)
    return self.Tokens[token]
end

function Theme:Set(name)
    local preset = self.Presets[name]
    if not preset then
        error(string.format("Unknown theme '%s'", tostring(name)), 2)
    end

    self.Name = name
    self.Base = name -- the preset a "Custom" theme started from (saved in configs)
    self.Tokens = Merge(preset)
    self.Explicit = {} -- tokens set by hand (SetToken); a new accent does not retint those
    BuildGradient(self.Tokens)
    Refresh()
end

-- Tokens that take the accent's hue when a custom accent is set: borders,
-- surfaces and the second gradient color. Brightness and saturation stay as the
-- preset made them, so a custom accent keeps the preset's depth.
local ACCENT_TINTED = { "Background", "Surface", "Element", "ElementHover", "Stroke", "StrokeHover" }

local function Retint(color, hue)
    local _, saturation, value = color:ToHSV()
    return Color3.fromHSV(hue, saturation, value)
end

-- Overrides one color token on top of the current theme (for example a custom
-- accent from a color picker). The theme name becomes "Custom".
function Theme:SetToken(token, color)
    if typeof(self.Tokens[token]) ~= "Color3" then
        error(string.format("'%s' is not a color token", tostring(token)), 2)
    end

    if typeof(color) ~= "Color3" then
        error("Theme:SetToken expects a Color3", 2)
    end

    self.Name = "Custom"
    self.Explicit = self.Explicit or {}
    self.Tokens[token] = color

    if token == "Accent" then
        -- Borders, sliders, the primary button... all follow the accent.
        local hue = color:ToHSV()
        local base = self.Presets[self.Base] or BASE_TOKENS

        for _, name in ipairs(ACCENT_TINTED) do
            if not self.Explicit[name] then
                self.Tokens[name] = Retint(base[name], hue)
            end
        end

        if not self.Explicit.AccentAlt then
            self.Tokens.AccentAlt = ShadeAccent(color)
        end
    else
        self.Explicit[token] = true
    end

    BuildGradient(self.Tokens)
    Refresh()
end

-- Adds a preset. Missing tokens fall back to the Dark preset.
function Theme:Register(name, tokens)
    local preset = Merge(BASE_TOKENS, tokens)
    preset.AccentAlt = tokens.AccentAlt or ShadeAccent(preset.Accent)
    self.Presets[name] = preset
end

function Theme:GetNames()
    local names = {}

    for name in pairs(self.Presets) do
        names[#names + 1] = name
    end

    table.sort(names)
    return names
end

-- Every preset gets its accent's darker shade as the gradient's second color,
-- unless it sets its own AccentAlt.
for _, preset in pairs(Theme.Presets) do
    if preset.AccentAlt == nil then
        preset.AccentAlt = ShadeAccent(preset.Accent)
    end
end

Theme:Set("Dark")


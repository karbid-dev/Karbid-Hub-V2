-- Icon + text button used in the profile card. Stays accent-colored while
-- its toggle is on. `callback(active)` runs on every click.
function Home.ToggleButton(parent, name, icon, label, callback)
    local button = Home.Tile(parent, name, 7, { Size = UDim2.new(0.333, -6, 1, 0) })

    local image = Create("ImageLabel", {
        Name = "Icon",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        Theme = { ImageColor3 = "TextDim" },
        Parent = button,
    })

    Icons:Apply(image, icon)

    local text = Home.Text(
        button, "Label", label, Fonts.Medium, Metrics.TextSmall,
        "TextDim", UDim2.new(0, 30, 0, 0), UDim2.new(1, -36, 1, 0)
    )

    local active = false

    local function render()
        TweenToken(image, "ImageColor3", active and "Accent" or "TextDim")
        TweenToken(text, "TextColor3", active and "Accent" or "TextDim")
    end

    button.MouseButton1Click:Connect(function()
        active = not active
        render()
        callback(active)
    end)

    return button
end


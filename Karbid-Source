local function Log(...)
    warn("[" .. LIBRARY_NAME .. "]", ...)
end

-- Returns a NEW table: every key of `base`, overridden by `overrides`.
-- Shallow copy. Create nested default tables inside the function that uses
-- them, never share one table between elements.
local function Merge(base, overrides)
    local result = {}

    for key, value in pairs(base) do
        result[key] = value
    end

    if overrides then
        for key, value in pairs(overrides) do
            result[key] = value
        end
    end

    return result
end

local function ColorToHex(color)
    return string.format(
        "%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5)
    )
end

-- Accepts "RRGGBB" or "#RRGGBB". Returns nil when the text is not a valid hex.
local function HexToColor(hex)
    hex = string.gsub(tostring(hex), "^#", "")

    local value = #hex == 6 and tonumber(hex, 16)
    if not value then
        return nil
    end

    return Color3.fromRGB(
        math.floor(value / 65536) % 256,
        math.floor(value / 256) % 256,
        value % 256
    )
end

-- ---------------------------------------------------------------------------
-- Signal: tiny event class. No allocation per Fire, safe to Disconnect while
-- firing, and one failing callback never blocks the others.
-- ---------------------------------------------------------------------------

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
    if self.Connected then
        self.Connected = false
        self._signal._dirty = true
    end
end

local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({
        _connections = {},
        _dirty = false,
        _depth = 0,
    }, Signal)
end

function Signal:Connect(callback)
    local connection = setmetatable({
        Connected = true,
        _callback = callback,
        _signal = self,
    }, Connection)

    local connections = self._connections
    connections[#connections + 1] = connection

    return connection
end

function Signal:Once(callback)
    local connection
    connection = self:Connect(function(...)
        connection:Disconnect()
        callback(...)
    end)

    return connection
end

-- Removes disconnected entries in place (only runs after a Disconnect).
local function Compact(connections)
    local count = #connections
    local keep = 0

    for index = 1, count do
        local connection = connections[index]
        if connection.Connected then
            keep = keep + 1
            connections[keep] = connection
        end
    end

    for index = keep + 1, count do
        connections[index] = nil
    end
end

function Signal:Fire(...)
    local connections = self._connections
    self._depth = self._depth + 1

    for index = 1, #connections do
        local connection = connections[index]
        if connection.Connected then
            local ok, err = pcall(connection._callback, ...)
            if not ok then
                Log("Signal callback error:", err)
            end
        end
    end

    self._depth = self._depth - 1

    if self._dirty and self._depth == 0 then
        self._dirty = false
        Compact(connections)
    end
end

function Signal:Destroy()
    for _, connection in ipairs(self._connections) do
        connection.Connected = false
    end
    self._connections = {}
end

-- ---------------------------------------------------------------------------
-- Janitor: collects anything that needs cleaning (connections, instances,
-- functions, objects with Destroy / Disconnect) and cleans it in one call.
-- ---------------------------------------------------------------------------

local function Clean(item)
    local kind = typeof(item)

    if kind == "function" then
        item()
    elseif kind == "RBXScriptConnection" then
        item:Disconnect()
    elseif kind == "Instance" then
        item:Destroy()
    elseif kind == "table" then
        if type(item.Destroy) == "function" then
            item:Destroy()
        elseif type(item.Disconnect) == "function" then
            item:Disconnect()
        end
    end
end

local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
    return setmetatable({ _items = {} }, Janitor)
end

function Janitor:Add(item)
    self._items[item] = true
    return item
end

function Janitor:Connect(signal, callback)
    return self:Add(signal:Connect(callback))
end

-- Cleans one item right now and forgets it.
function Janitor:Remove(item)
    if self._items[item] then
        self._items[item] = nil
        Clean(item)
    end
end

function Janitor:Cleanup()
    local items = self._items
    self._items = {}

    for item in pairs(items) do
        local ok, err = pcall(Clean, item)
        if not ok then
            Log("Cleanup error:", err)
        end
    end
end

Janitor.Destroy = Janitor.Cleanup


-- Button
-- ----------------------------------------------------------------------------

local Button = setmetatable({}, { __index = Element })
Button.__index = Button
Button.ClassName = "Button"

local BUTTON_SCHEMA = Merge(COMMON_SCHEMA, {
    Title = { "Button", "string" },
    Style = { "Default", "string" }, -- Default, or Primary for the accent gradient fill
    Callback = { NOOP, "function" },
})

function Button.new(section, flag, settings)
    if settings.Style ~= "Default" and settings.Style ~= "Primary" then
        error(string.format("Button '%s': Style must be Default or Primary", settings.Title), 3)
    end

    local self = Element.new(Button, section, flag, settings, {
        Interactive = true,
        Reserve = 22,
    })

    -- Primary: the card is filled with the accent gradient, with light text.
    -- (The card color stays white so the gradient shows its own colors.)
    if settings.Style == "Primary" then
        self._primary = true
        Theme:Bind(self.Card, { BackgroundColor3 = "OnAccent" })
        Theme:Bind(self.TitleLabel, { TextColor3 = "OnAccent" })
        Theme:Bind(self.DescLabel, { TextColor3 = "OnAccent" })
        Create("UIGradient", { Theme = { Color = "Gradient" }, Parent = self.Card })
    end

    local arrow = Create("TextLabel", {
        Name = "Arrow",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -Metrics.ElementPadding, 0.5, 0),
        Size = UDim2.fromOffset(12, 18),
        Font = Fonts.Bold,
        TextSize = 18,
        Text = "›",
        Theme = { TextColor3 = self._primary and "OnAccent" or "TextDim" },
        Parent = self.Card,
    })

    self:_Fade(arrow, "TextTransparency", 0)

    self.Hit.MouseButton1Click:Connect(function()
        self:Fire()
    end)

    self:_Finish()
    return self
end

-- A Primary button dims slightly on hover instead of changing color.
function Button:_RenderHover()
    if not self._primary then
        Element._RenderHover(self)
        return
    end

    TweenToken(self.Card, "BackgroundColor3", "OnAccent")
    Tween(self.Card, "Hover", { BackgroundTransparency = self._hovered and 0.15 or 0 })
end

-- Runs the callback, exactly like a click.
function Button:Fire()
    if self.Destroyed then
        return
    end

    self:_Pulse()
    self:_Call(self.Settings.Callback)
end

function Button:SetCallback(callback)
    if type(callback) ~= "function" then
        error("Button:SetCallback expects a function", 2)
    end

    self.Settings.Callback = callback
end


-- ----------------------------------------------------------------------------
-- Settings: validation and defaults
-- ----------------------------------------------------------------------------

-- schema[key] = { default, "type", "type", ... }  (types as returned by typeof)
-- Returns a NEW table with every default filled in. A wrong type raises a clear
-- error; an unknown key only warns (a typo should not stop the whole script).
-- `level` is how many calls above this function the user's code is.
local function ReadSettings(kind, name, schema, given, level)
    given = given or {}
    local settings = {}

    for key, rule in pairs(schema) do
        local value = given[key]
        if value == nil then
            value = rule[1]
        end

        local valid = false
        for index = 2, #rule do
            if typeof(value) == rule[index] then
                valid = true
                break
            end
        end

        if not valid then
            error(
                string.format(
                    "%s '%s': %s expects %s, got %s",
                    kind,
                    name,
                    key,
                    table.concat(rule, " or ", 2, #rule),
                    typeof(value)
                ),
                level
            )
        end

        settings[key] = value
    end

    for key in pairs(given) do
        if schema[key] == nil then
            Log(string.format("%s '%s': unknown setting '%s' (ignored)", kind, name, tostring(key)))
        end
    end

    return settings
end

-- Accepts (settings) or (flag, settings). Checks the flag, returns both.
local function Prepare(kind, schema, a, b)
    local flag, given

    if typeof(a) == "table" then
        given = a
    else
        flag, given = a, b
    end

    given = given or {}

    if flag ~= nil then
        if type(flag) ~= "string" or flag == "" then
            error(kind .. ": the flag must be a non-empty string", 3)
        end

        if Library.Options[flag] then
            error(string.format("%s: duplicate flag '%s'", kind, flag), 3)
        end
    end

    local name = flag or given.Title or given.Text or kind
    return flag, ReadSettings(kind, tostring(name), schema, given, 4)
end

local COMMON_SCHEMA = {
    Title = { "Element", "string" },
    Description = { "", "string" },
    Icon = { "", "string", "number" },
    Tooltip = { "", "string" },
    ShowIf = { false, "boolean", "string", "table", "function" },
    Visible = { true, "boolean" },
    IgnoreConfig = { false, "boolean" },
}

-- ShowIf accepts:
--     "AutoCatch"                  shown while that option is on / set
--     { "Mode", "Farm" }           shown while Library.Options.Mode.Value == "Farm"
--     function() return true end   shown while the function returns true
local function ParseCondition(spec)
    local kind = typeof(spec)

    if kind == "function" then
        return spec
    end

    if kind == "string" then
        return function()
            local option = Library.Options[spec]
            return option ~= nil and option.Value ~= nil and option.Value ~= false
        end
    end

    if kind == "table" then
        local flag = spec.Flag or spec[1]
        local expected = spec.Value
        if expected == nil then
            expected = spec[2]
        end

        return function()
            local option = Library.Options[flag]
            if option == nil then
                return false
            end

            if expected == nil then
                return option.Value ~= nil and option.Value ~= false
            end

            return option.Value == expected
        end
    end

    return nil
end

-- ----------------------------------------------------------------------------
-- Element base class. Everything shared by every element lives here: the card,
-- title / description / icon, fade-in, hover, tooltip, error flash, visibility
-- (SetVisible + ShowIf), flag registration and cleanup. An element type only
-- writes what is unique to it.
-- ----------------------------------------------------------------------------

local Element = {}
Element.__index = Element
Element.Savable = false -- config saving only touches elements that set this

-- layout.Interactive  the card gets a click area and a hover effect
-- layout.Reserve      pixels kept free on the right for the element's control
-- layout.Inset        extra pixels on the left (labels use it for their bar)
function Element.new(class, section, flag, settings, layout)
    local padding = Metrics.ElementPadding
    local inset = layout.Inset or 0
    local hasIcon = settings.Icon ~= ""
    local iconSpace = hasIcon and 26 or 0
    local hasFooter = layout.Footer ~= nil

    local self = setmetatable({
        Class = class.ClassName,
        Flag = flag,
        Settings = settings,
        Title = settings.Title,
        Tooltip = settings.Tooltip,
        IgnoreConfig = settings.IgnoreConfig,
        Section = section,
        Window = section.Window,
        Destroyed = false,
        _janitor = Janitor.new(),
        _fades = {},
        _hovered = false,
        _flashing = false,
        _hidden = settings.Visible == false,
        _conditionMet = true,
        _condition = ParseCondition(settings.ShowIf),
        _interactive = layout.Interactive == true,
        _topAnchored = layout.Footer ~= nil,
    }, class)

    local stroke = Stroke("Stroke", nil, Metrics.StrokeTransparency)

    local card = Create("Frame", {
        Name = settings.Title,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        LayoutOrder = section:_NextOrder(),
        Theme = { BackgroundColor3 = "Element" },
        Parent = section.Container,
    }, {
        Corner(),
        stroke,
        Create("UISizeConstraint", { MinSize = Vector2.new(0, Metrics.ElementHeight) }),
    })

    local main = Create("Frame", {
        Name = "Main",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = card,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, hasFooter and 6 or 0),
        }),
        Create("UIPadding", {
            PaddingTop = UDim.new(0, padding),
            PaddingBottom = UDim.new(0, padding),
            PaddingLeft = UDim.new(0, padding + inset + iconSpace),
            PaddingRight = UDim.new(0, padding + (layout.Reserve or 0)),
        }),
    })

    -- Head = title + description. Footer (optional) sits under it: sliders put
    -- their track there, dropdowns and color pickers expand into it.
    local head = Create("Frame", {
        Name = "Head",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = main,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 2),
        }),
    })

    local title = Create("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Fonts.Medium,
        TextSize = Metrics.TextBody,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Text = settings.Title,
        LayoutOrder = 1,
        Theme = { TextColor3 = "Text" },
        Parent = head,
    })

    local description = Create("TextLabel", {
        Name = "Description",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Fonts.Regular,
        TextSize = Metrics.TextSmall,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Text = settings.Description,
        Visible = settings.Description ~= "",
        LayoutOrder = 2,
        Theme = { TextColor3 = "TextDim" },
        Parent = head,
    })

    -- The right side of the card is kept free for the element's control, so a
    -- footer is narrower than the card by that much. FooterFull gives it back
    -- (the dropdown list and the color picker use the whole card width).
    local footerWidth = layout.FooterFull and (layout.Reserve or 0) or 0

    local footer
    if hasFooter then
        footer = Create("Frame", {
            Name = "Footer",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            Size = UDim2.new(1, footerWidth, 0, layout.Footer),
            Visible = layout.Footer > 0,
            LayoutOrder = 2,
            Parent = main,
        })
    end

    local hit
    if self._interactive then
        hit = Create("TextButton", {
            Name = "Interact",
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            -- With a footer the click area covers only the header (top padding
            -- + title / description) and stops short of the footer, so the
            -- footer's own controls (track, list, picker) stay clickable.
            Size = UDim2.new(1, -(layout.HitInset or 0), hasFooter and 0 or 1, hasFooter and (padding + Metrics.TextBody + 3) or 0),
            ZIndex = 2,
            Parent = card,
        })
    end

    self.Card = card
    self.Stroke = stroke
    self.TitleLabel = title
    self.DescLabel = description
    self.Hit = hit or card
    self.Footer = footer
    self._footerWidth = footerWidth

    if hasFooter and hit then
        head:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            hit.Size = UDim2.new(1, -(layout.HitInset or 0), 0, head.AbsoluteSize.Y + padding + 3)
        end)
    end
    self._janitor:Add(card)

    self:_Fade(card, "BackgroundTransparency", Metrics.ElementTransparency)
    self:_Fade(stroke, "Transparency", Metrics.StrokeTransparency)
    self:_Fade(title, "TextTransparency", 0)
    self:_Fade(description, "TextTransparency", 0)

if hasIcon then
        local icon = Create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, padding + inset, 0.5, 0),
            Size = UDim2.fromOffset(22, 22),
            Theme = { ImageColor3 = "TextDim" },
            Parent = card,
        })

        Icons:Apply(icon, settings.Icon)
        self.IconImage = icon
        self:_Fade(icon, "ImageTransparency", 0)
    end

    self.Hit.MouseEnter:Connect(function()
        self:_SetHover(true)
    end)

    self.Hit.MouseLeave:Connect(function()
        self:_SetHover(false)
    end)

    return self
end

-- Records a property that should fade in when the element is created.
function Element:_Fade(instance, property, final)
    self._fades[#self._fades + 1] = { instance, property, final }
end

-- Elements on the tab you are looking at fade in; elements on other tabs are
-- placed directly (nothing is wasted animating something nobody can see).
function Element:_PlayIn()
    local animate = self.Section.Tab.Page.Visible

    for _, fade in ipairs(self._fades) do
        local instance, property, final = fade[1], fade[2], fade[3]

        if animate then
            instance[property] = 1
            Tween(instance, "Show", { [property] = final })
        else
            instance[property] = final
        end
    end

    self._fades = {}
end

-- Call at the END of every element constructor, once the control is built.
function Element:_Finish()
    self:_PlayIn()
    self.Window.Elements[self] = true

    if self._condition then
        self._janitor:Add(Library.OptionChanged:Connect(function()
            self:_UpdateCondition()
        end))
        self:_UpdateCondition()
    end

    self:_Refresh()

    if self.Flag then
        Library.Options[self.Flag] = self
        Library.OptionChanged:Fire(self.Flag)
    end
end

function Element:_UpdateCondition()
    local ok, result = pcall(self._condition)
    local met = ok and result and true or false

    if met ~= self._conditionMet then
        self._conditionMet = met
        self:_Refresh()
    end
end

function Element:_Refresh()
    self.Card.Visible = not self._hidden and self._conditionMet
end

function Element:_RenderHover()
    local hovered = self._hovered and self._interactive

    TweenToken(self.Card, "BackgroundColor3", hovered and "ElementHover" or "Element")
    TweenToken(self.Stroke, "Color", hovered and "StrokeHover" or "Stroke")
end

function Element:_SetHover(state)
    self._hovered = state

    if self._interactive and not self._flashing then
        self:_RenderHover()
    end

    if state then
        if self.Tooltip ~= "" then
            self.Window:_TooltipShow(self.Tooltip)

            if not self._moveConnection then
                self._moveConnection = self.Hit.MouseMoved:Connect(function()
                    self.Window:_TooltipMove()
                end)
            end
        end
    else
        if self._moveConnection then
            self._moveConnection:Disconnect()
            self._moveConnection = nil
        end

        self.Window:_TooltipHide()
    end
end

-- Puts a control (value text, swatch, chip) on the right edge of the header
-- row. Elements with a footer keep it level with the first line of text.
function Element:_PlaceControl(control, right)
    control.AnchorPoint = Vector2.new(1, 0.5)

    if self._topAnchored then
        control.Position = UDim2.new(1, -right, 0, Metrics.ElementHeight / 2)
    else
        control.Position = UDim2.new(1, -right, 0.5, 0)
    end
end

-- The footer's size for a given height (see FooterFull).
function Element:_FooterSize(height)
    return UDim2.new(1, self._footerWidth, 0, height)
end

-- A quick accent flash on the border: feedback that a press registered.
function Element:_Pulse()
    self.Stroke.Color = Theme.Tokens.Accent
    TweenToken(self.Stroke, "Color", self._hovered and "StrokeHover" or "Stroke", "Flash")
end

-- Runs a user callback. A failing callback is logged with its traceback and the
-- card flashes red; it never breaks the UI or the other elements.
function Element:_Call(callback, ...)
    local ok, err = xpcall(callback, TraceHandler, ...)

    if not ok then
        self:_ReportError(err)
    end

    return ok
end

function Element:_ReportError(err)
    Log(string.format("%s '%s' error: %s", self.Class, self.Title, tostring(err)))
    self:_Flash()
end

function Element:_Flash()
    if self._flashing or self.Destroyed then
        return
    end

    self._flashing = true
    TweenToken(self.Card, "BackgroundColor3", "ErrorFill", "Flash")
    self.TitleLabel.Text = "Callback Error"

    task.delay(0.5, function()
        if self.Destroyed then
            return
        end

        self._flashing = false
        self.TitleLabel.Text = self.Title
        self:_RenderHover()
    end)
end

function Element:SetTitle(title)
    self.Title = title
    self.Settings.Title = title
    self.Card.Name = title

    if not self._flashing then
        self.TitleLabel.Text = title
    end
end

function Element:SetDescription(text)
    self.Settings.Description = text
    self.DescLabel.Text = text
    self.DescLabel.Visible = text ~= ""
end

function Element:SetTooltip(text)
    self.Tooltip = text
    self.Settings.Tooltip = text

    if text == "" and self._hovered then
        self.Window:_TooltipHide()
    end
end

-- True while the card is shown (not hidden by SetVisible and ShowIf is met).
function Element:IsVisible()
    return not self._hidden and self._conditionMet
end

-- Manual show / hide. Combines with ShowIf: shown only when BOTH allow it.
function Element:SetVisible(visible)
    self._hidden = not visible
    self:_Refresh()

    if not visible and self._hovered then
        self:_SetHover(false)
    end
end

function Element:Destroy()
    if self.Destroyed then
        return
    end
    self.Destroyed = true

    if self._hovered then
        self.Window:_TooltipHide()
    end

    self._janitor:Cleanup()
    self.Window.Elements[self] = nil
    self.Section:_Forget(self)

    if self.Flag and Library.Options[self.Flag] == self then
        Library.Options[self.Flag] = nil
        Library.OptionChanged:Fire(self.Flag)
    end
end


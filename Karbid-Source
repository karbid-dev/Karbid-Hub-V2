local function SetShadowStyle(shadow, style)
    local spread, offset, transparency = table.unpack(SHADOW_STYLES[style])

    Tween(shadow, "Hover", {
        Size = UDim2.new(1, spread, 1, spread),
        Position = UDim2.new(0.5, 0, 0.5, offset),
        ImageTransparency = transparency,
    })
end

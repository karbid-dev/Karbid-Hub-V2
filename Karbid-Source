-- Nebula Icon Library, fetched once in the background. If it cannot load
-- (Studio, blocked network, site down) the UI still works, icons are skipped.
--
--     "settings"               default pack (Lucide)
--     "material:settings"      pick a pack: material, lucide, phosphor,
--                              phosphor-filled, sf, symbols, symbols-filled,
--                              lab, fluency, nebula
--     123456789                raw asset id (number, "123", or "rbxassetid://123")
--     Icons:Register("logo", 123456789) then "logo"   your own names
-- ============================================================================

local ICON_PACKS = {
    material = "Material",
    lucide = "Lucide",
    phosphor = "Phosphor",
    ["phosphor-filled"] = "Phosphor-Filled",
    sf = "SF",
    symbols = "Symbols",
    ["symbols-filled"] = "Symbols-Filled",
    lab = "Lab",
    fluency = "Fluency",
    nebula = "nebulaIcons",
}

local Icons = {
    Ready = false,
    Failed = false,
    Disabled = false,
    Nebula = nil, -- the loaded icon library, once available
    Custom = {},
    Images = setmetatable({}, { __mode = "k" }), -- every image that shows an icon (the loading screen preloads them)
    _pending = {},
}

local function ToAssetUrl(value)
    if type(value) == "number" then
        return string.format("rbxassetid://%d", value)
    end

    if type(value) == "string" then
        if string.find(value, "^rbxassetid://") or string.find(value, "^https?://") then
            return value
        end

        if tonumber(value) then
            return "rbxassetid://" .. value
        end
    end

    return nil
end

function Icons:Register(name, asset)
    local url = ToAssetUrl(asset)
    if not url then
        error("Icons:Register expects an asset id", 2)
    end

    self.Custom[name] = url
end

-- Returns an image url, or nil when the icon is unknown or not loaded yet.
function Icons:Resolve(spec)
    local direct = ToAssetUrl(spec)
    if direct then
        return direct
    end

    if type(spec) ~= "string" or spec == "" then
        return nil
    end

    if self.Custom[spec] then
        return self.Custom[spec]
    end

    local nebula = self.Nebula
    if not nebula then
        return nil
    end

    local packKey, name = string.match(spec, "^([%w%-]+):(.+)$")
    local pack = DEFAULT_ICON_PACK

    if packKey then
        pack = ICON_PACKS[string.lower(packKey)]
        if not pack then
            return nil
        end
    else
        name = spec
    end

    local ok, id = pcall(nebula.GetIcon, nebula, name, pack)
    id = ok and tonumber(id) or nil

    if id then
        return string.format("rbxassetid://%d", id)
    end

    return nil
end

-- Sets image.Image now, or as soon as the icon library finishes loading.
function Icons:Apply(image, spec)
    self.Images[image] = true
    local url = self:Resolve(spec)

    if url then
        image.Image = url
    elseif type(spec) == "string" and not (self.Ready or self.Failed or self.Disabled) then
        self._pending[#self._pending + 1] = { image = image, spec = spec }
    end
end

function Icons:Load()
    task.spawn(function()
        local ok, result = pcall(function()
            return loadstring(game:HttpGet(ICON_LOADER_URL))()
        end)

        if self.Disabled then
            return
        end

        if ok and type(result) == "table" and type(result.GetIcon) == "function" then
            self.Nebula = result
            self.Ready = true

            local pending = self._pending
            self._pending = {}

            for _, entry in ipairs(pending) do
                local url = self:Resolve(entry.spec)
                if url then
                    entry.image.Image = url
                end
            end
        else
            self.Failed = true
            self._pending = {}

            if not Env.IsStudio then
                Log("Icons unavailable:", tostring(result))
            end
        end
    end)
end

function Icons:Disable()
    self.Disabled = true
    self._pending = {}
end

-- ============================================================================
-- [06] CORE
-- ============================================================================

-- What Library:Connect / Library:Every return. Disconnect stops it AND frees
-- it from the cleanup list, so toggling a loop on and off never piles up.
local Handle = {}
Handle.__index = Handle

function Handle.new(janitor, item)
    janitor:Add(item)

    return setmetatable({
        Connected = true,
        _janitor = janitor,
        _item = item,
    }, Handle)
end

function Handle:Disconnect()
    if self.Connected then
        self.Connected = false
        self._janitor:Remove(self._item)
    end
end

local Library = {
    Name = LIBRARY_NAME,
    Version = LIBRARY_VERSION,
    Env = Env,
    Theme = Theme,
    Icons = Icons,
    Options = {}, -- flag -> element, filled by the elements (config uses it)
    OptionChanged = Signal.new(), -- fires with the flag when an option is added, removed or changed
    Unloading = Signal.new(),
    Unloaded = false,

    -- Building blocks for the library itself and for your own scripts.
    Util = {
        Signal = Signal,
        Janitor = Janitor,
        Merge = Merge,
        ColorToHex = ColorToHex,
        HexToColor = HexToColor,
        Tweens = Tweens,
        Tween = Tween,
        TweenToken = TweenToken,
        Create = Create,
        Corner = Corner,
        Stroke = Stroke,
        Padding = Padding,
    },

    _janitor = Janitor.new(),
}

-- Connects to any signal; everything is disconnected on Unload.
--     local handle = Library:Connect(Players.PlayerAdded, function(player) end)
--     handle:Disconnect()
function Library:Connect(signal, callback)
    return Handle.new(self._janitor, signal:Connect(callback))
end

-- Runs `callback` every `seconds` (0 = every frame) until disconnected or
-- unloaded. The callback receives the seconds elapsed since its last call.
function Library:Every(seconds, callback)
    if seconds <= 0 then
        return Handle.new(self._janitor, RunService.Heartbeat:Connect(callback))
    end

    local elapsed = 0

    return Handle.new(self._janitor, RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt

        if elapsed >= seconds then
            local passed = elapsed
            elapsed = elapsed % seconds
            callback(passed)
        end
    end))
end

-- Hands anything (Instance, connection, function, object) to the cleanup list.
function Library:Track(item)
    return self._janitor:Add(item)
end

function Library:Unload()
    if self.Unloaded then
        return
    end
    self.Unloaded = true

    self.Unloading:Fire()
    self._janitor:Cleanup()
    Icons:Disable()
    table.clear(self.Options)
    self.Window = nil

    if Genv[INSTANCE_KEY] == self then
        Genv[INSTANCE_KEY] = nil
    end
end


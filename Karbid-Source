-- How far the script is (0 to 100, first stage only) and / or status text.
-- Either can be nil.
function Window:SetLoading(percent, status)
    if percent ~= nil and type(percent) ~= "number" then
        error("Window:SetLoading expects a number (0 to 100) or nil as the percent", 2)
    end

    if status ~= nil and type(status) ~= "string" then
        error("Window:SetLoading expects a string or nil as the status", 2)
    end

    if not self.Loading then
        return
    end

    if percent ~= nil and not self._finishing then
        self._loadManual = true
        self._loadBuild = math.clamp(percent / 100, 0, 1)
        self._loadTarget = LOADING_BUILD_SHARE * self._loadBuild
    end

    if status ~= nil then
        self.LoadingStatus.Text = status
    end
end

-- Called after every created tab, section and element. Moves the first stage
-- (unless the script drives it) and, now and then, lets a frame render.
function Window:_LoadWork()
    if not self.Loading or self._finishing then
        return
    end

    self._loadWork = self._loadWork + 1

    if not self._loadManual then
        local count = self._loadWork
        self._loadBuild = count / (count + 20)
        self._loadTarget = LOADING_BUILD_SHARE * self._loadBuild
    end

    if self._loadWork % LOADING_YIELD_EVERY == 0 and coroutine.isyieldable() then
        task.wait()
    end
end

function Window:_StepLoading(dt)
    if self.Destroyed or not self.Loading then
        return
    end

    self._loadTime = self._loadTime + dt

    if self._finishing then
        self:_StepStages(dt)
    end

    local shown = self._loadShown + (self._loadTarget - self._loadShown) * math.min(1, dt * 6)

    if math.abs(self._loadTarget - shown) < 0.002 then
        shown = self._loadTarget
    end

    self._loadShown = shown
    self.LoadingFill.Size = UDim2.new(shown, 0, 1, 0)
    self.LoadingPercent.Text = string.format("%d%%", math.floor(shown * 100 + 0.5))

    if self._finishing then
        if self._stage == "fill" and shown >= 1 and self._loadTime >= LOADING_MIN then
            self:_RevealWindow()
        end
    elseif self._loadTime >= self.Settings.LoadingTimeout then
        Log("The loading screen timed out: Window:Ready() was never called. Opening the window.")
        self:Ready()
    end
end

-- Stages after Ready(): icon library, then image preloading, then the last fill.
function Window:_StepStages(dt)
    self._stageTime = self._stageTime + dt

    if self._stage == "icons" then
        if Icons.Ready or Icons.Failed or Icons.Disabled or self._stageTime >= LOADING_ICON_WAIT then
            self._loadTarget = LOADING_ICONS_SHARE
            self:_StartImages()
        end
    elseif self._stage == "images" then
        local total, done = self._imageTotal, self._imageDone

        if self._imagesFinished or self._stageTime >= LOADING_IMAGE_WAIT then
            self._stage = "fill"
            self._loadTarget = 1
            self.LoadingStatus.Text = "Ready"
        elseif total > 0 then
            self._loadTarget = LOADING_ICONS_SHARE + (1 - LOADING_ICONS_SHARE) * math.min(1, done / total)
            self.LoadingStatus.Text = string.format("Loading images (%d/%d)...", math.min(done, total), total)
        end
    end
end

-- Preloads every icon image that exists right now (ContentProvider), counting
-- them as they arrive. Without ContentProvider (Studio tests) it just moves on.
function Window:_StartImages()
    self._stage = "images"
    self._stageTime = 0
    self._imageTotal = 0
    self._imageDone = 0
    self._imagesFinished = false

    local list = {}

    for image in pairs(Icons.Images) do
        if image.Parent ~= nil and image.Image ~= "" then
            list[#list + 1] = image
        end
    end

    local ok, service = pcall(function()
        return game:GetService("ContentProvider")
    end)

    if #list == 0 or not ok or not service then
        self._imagesFinished = true
        return
    end

    self._imageTotal = #list
    self.LoadingStatus.Text = string.format("Loading images (0/%d)...", #list)

    task.spawn(function()
        pcall(function()
            service:PreloadAsync(list, function()
                self._imageDone = self._imageDone + 1
            end)
        end)

        self._imagesFinished = true
    end)
end

-- Ends the first stage and starts the icon / image stages.
function Window:_FinishLoading(onDone)
    self._finishing = true
    self._loadDone = onDone
    self._stage = "icons"
    self._stageTime = 0
    self._loadBuild = 1
    self._loadTarget = LOADING_BUILD_SHARE
    self.LoadingStatus.Text = "Loading icons..."
end

function Window:_RevealWindow()
    self.Loading = false

    if self._loadLoop then
        self._loadLoop:Disconnect()
        self._loadLoop = nil
    end

    local gui = self.LoadingGui
    Tween(self.LoadingBackdrop, "Fade", { BackgroundTransparency = 1 })
    Tween(self.LoadingCard, "Fade", { GroupTransparency = 1 })

    self.Surface.GroupTransparency = 1
    self.Main.Visible = true
    Tween(self.Surface, "Show", { GroupTransparency = 0 })

    task.delay(LOADING_FADE, function()
        if gui then
            gui:Destroy()
        end

        if self.LoadingGui == gui then
            self.LoadingGui = nil
        end

        local done = self._loadDone
        self._loadDone = nil

        if done and not self.Destroyed then
            done()
        end

        self.Loaded:Fire()
    end)
end

-- The close button: hide the window and show the island, or unload when the
-- window was created with Island = false.
function Window:Close()
    if self.Settings.Island then
        self:SetVisible(false)
    else
        Library:Unload()
    end
end

-- Ping in milliseconds, or nil when the engine does not report it.
function Window:_ReadPing()
    local ok, value = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)

    if ok and type(value) == "number" then
        return value
    end

    local fallbackOk, seconds = pcall(function()
        return Players.LocalPlayer:GetNetworkPing()
    end)

    if fallbackOk and type(seconds) == "number" then
        return seconds * 1000
    end

    return nil
end

local function StatToken(value, good, fair)
    if value >= good then
        return "Success"
    elseif value >= fair then
        return "Warning"
    end

    return "Error"
end

-- Writes ping and FPS to the island, colored by how healthy they are.
function Window:_RenderStats(fps)
    local ping = self:_ReadPing()

    if ping then
        self.PingLabel.Text = string.format("%d ms", math.floor(ping + 0.5))
        -- Low ping is good, so the scale is flipped.
        local token = ping <= 80 and "Success" or (ping <= 160 and "Warning" or "Error")
        TweenToken(self.PingLabel, "TextColor3", token)
    else
        self.PingLabel.Text = "-- ms"
        TweenToken(self.PingLabel, "TextColor3", "TextMuted")
    end

    if fps then
        self.FpsLabel.Text = string.format("%d FPS", math.floor(fps + 0.5))
        TweenToken(self.FpsLabel, "TextColor3", StatToken(fps, 50, 30))
    else
        self.FpsLabel.Text = "-- FPS"
        TweenToken(self.FpsLabel, "TextColor3", "TextMuted")
    end
end

-- Stats only update while the island is on screen.
function Window:_StartStats()
    if self._stats then
        return
    end

    local frames = 0

    local beat = Library:Connect(RunService.Heartbeat, function()
        frames = frames + 1
    end)

    local loop = Library:Every(STATS_INTERVAL, function(elapsed)
        local fps = frames / elapsed
        frames = 0
        self:_RenderStats(fps)
    end)

    self._stats = { beat, loop }
    self:_RenderStats(nil)
end

function Window:_StopStats()
    if not self._stats then
        return
    end

    for _, handle in ipairs(self._stats) do
        handle:Disconnect()
    end

    self._stats = nil
end

-- Where the island sits: its home, or the top middle while tucked away.
function Window:_IslandTarget()
    local home = self._islandHome

    if self._islandTucked then
        return UDim2.new(home.X.Scale, home.X.Offset, 0, -(ISLAND_HEIGHT + ISLAND_HIDE_GAP))
    end

    return UDim2.new(home.X.Scale, home.X.Offset, 0, ISLAND_TOP)
end

function Window:SetIslandTucked(tucked)
    if not self.Island or tucked == self._islandTucked or self.Destroyed then
        return
    end

    self._islandTucked = tucked

    Tween(self.Island, "Hover", { Position = self:_IslandTarget() })
    Tween(self.TuckButton, "Hover", {
        Rotation = tucked and 90 or -90,
        TextTransparency = tucked and TUCK_TUCKED or TUCK_IDLE,
    })
end

-- The island shows exactly while the window is hidden.
function Window:_SyncIsland()
    if not self.Island or self.Destroyed then
        return
    end

    local show = not self.Visible
    self.IslandGui.Enabled = show

    if show then
        local home = self:_IslandTarget()
        self.Island.Position = UDim2.new(home.X.Scale, home.X.Offset, 0, home.Y.Offset - 60)
        Tween(self.Island, "Hover", { Position = home })
        self:_StartStats()
    else
        self:_StopStats()
    end
end

function Window:_BuildIsland()
    local gui = Create("ScreenGui", {
        Name = LIBRARY_NAME .. "Island",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1001, -- above the window and the panels
        Enabled = false,
    })

    ProtectGui(gui)
    Library:Track(gui)
    AddOriginProbe(gui)

    local stroke = Stroke("Stroke")

    local island = Create("Frame", {
        Name = "Island",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, ISLAND_TOP),
        Size = UDim2.new(0, 0, 0, ISLAND_HEIGHT),
        AutomaticSize = Enum.AutomaticSize.X,
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Surface" },
        Parent = gui,
    }, {
        Corner(18),
        stroke,
    })

    -- The row is laid out by the list; the hit button covers the whole island.
    local row = Create("Frame", {
        Name = "Row",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = island,
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 10),
        }),
        Create("UIPadding", {
            PaddingLeft = UDim.new(0, 16),
            PaddingRight = UDim.new(0, 16),
        }),
    })

    -- `width` fixes the label's width (the stats change every second).
    local function text(name, order, font, token, content, width)
        return Create("TextLabel", {
            Name = name,
            BackgroundTransparency = 1,
            LayoutOrder = order,
            Size = UDim2.new(0, width or 0, 0, 18),
            AutomaticSize = width and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = font,
            TextSize = Metrics.TextSmall + 1,
            Text = content,
            Theme = { TextColor3 = token },
            Parent = row,
        })
    end

    Create("Frame", {
        Name = "Dot",
        LayoutOrder = 1,
        Size = UDim2.fromOffset(8, 8),
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Accent" },
        Parent = row,
    }, {
        Corner(4),
    })

    text("Title", 2, Fonts.Bold, "Text", self.Title)

    Create("Frame", {
        Name = "Divider",
        LayoutOrder = 3,
        Size = UDim2.fromOffset(1, 14),
        BorderSizePixel = 0,
        Theme = { BackgroundColor3 = "Stroke" },
        Parent = row,
    })

    self.PingLabel = text("Ping", 4, Fonts.Medium, "TextMuted", "-- ms", ISLAND_PING_WIDTH)
    self.FpsLabel = text("Fps", 5, Fonts.Medium, "TextMuted", "-- FPS", ISLAND_FPS_WIDTH)

    local hit = Create("TextButton", {
        Name = "Hit",
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 5,
        Parent = island,
    })

    hit.MouseEnter:Connect(function()
        TweenToken(stroke, "Color", "Accent")
    end)

    hit.MouseLeave:Connect(function()
        TweenToken(stroke, "Color", "Stroke")
    end)

    -- Drag the island sideways. It keeps its height (just below the engine's
    -- top bar), so it cannot be dropped into that strip. A press that moved
    -- more than a few pixels is a drag, so the click that follows it does not
    -- reopen the window.
    local dragged = false

    hit.InputBegan:Connect(function(input)
        if not IsPress(input) or self._islandTucked then
            return
        end

        dragged = false

        local startPointer = input.Position
        local startPosition = island.Position
        local startAbsolute = island.AbsolutePosition
        local size = island.AbsoluteSize
        local viewport = gui.AbsoluteSize
        local _, insetLeft, insetRight = GuiInset()

        BeginDrag(input, function(pointer)
            local deltaX = pointer.X - startPointer.X

            if not dragged and math.abs(deltaX) < ISLAND_DRAG_THRESHOLD then
                return
            end

            dragged = true

            local x = math.clamp(startAbsolute.X + deltaX, insetLeft, math.max(insetLeft, viewport.X - insetRight - size.X))

            -- Moves by the distance travelled (see the panel drag): no jump.
            island.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + (x - startAbsolute.X),
                startPosition.Y.Scale,
                startPosition.Y.Offset
            )

            self._islandHome = island.Position -- it opens here next time
        end)
    end)

    hit.MouseButton1Click:Connect(function()
        if dragged then
            dragged = false
            return
        end

        self:SetVisible(true)
    end)

    -- A small arrow under the island tucks it up out of sight (only the arrow
    -- stays, the island does not move sideways); click it again to bring it back.
    -- It is faint until the pointer is near, like the section arrows.
    local tuck = Create("TextButton", {
        Name = "Tuck",
        Text = "›",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 1, 2),
        Size = UDim2.fromOffset(32, 14),
        Font = Fonts.Bold,
        TextSize = 18,
        TextTransparency = TUCK_IDLE,
        Rotation = -90,
        ZIndex = 6,
        Theme = { TextColor3 = "Text" },
        Parent = island,
    })

    tuck.MouseEnter:Connect(function()
        Tween(tuck, "Hover", { TextTransparency = 0.1 })
    end)

    tuck.MouseLeave:Connect(function()
        Tween(tuck, "Hover", { TextTransparency = self._islandTucked and TUCK_TUCKED or TUCK_IDLE })
    end)

    tuck.MouseButton1Click:Connect(function()
        self:SetIslandTucked(not self._islandTucked)
    end)

    self.TuckButton = tuck
    self._islandHome = island.Position
    self._islandTucked = false

    gui.Parent = Env.GetGuiParent()

    self.IslandGui = gui
    self.Island = island
end

-- Resize handle on the bottom-left corner. Dragging left / down makes the
-- window bigger; the right edge and the top edge stay where they are.
function Window:_BuildResize(main)
    local handle = Create("Frame", {
        Name = "ResizeHandle",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Active = true,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.fromOffset(RESIZE_GRIP, RESIZE_GRIP),
        ZIndex = 11,
        Parent = main,
    })

    -- Three dots in the corner, like a grip.
    local dots = {}
    for _, at in ipairs({ { 7, 16 }, { 12, 16 }, { 7, 11 } }) do
        dots[#dots + 1] = Create("Frame", {
            Name = "Dot",
            Position = UDim2.fromOffset(at[1], at[2]),
            Size = UDim2.fromOffset(3, 3),
            BorderSizePixel = 0,
            Theme = { BackgroundColor3 = "TextMuted" },
            Parent = handle,
        }, {
            Corner(2),
        })
    end

    handle.MouseEnter:Connect(function()
        for _, dot in ipairs(dots) do
            TweenToken(dot, "BackgroundColor3", "Accent")
        end
    end)

    handle.MouseLeave:Connect(function()
        for _, dot in ipairs(dots) do
            TweenToken(dot, "BackgroundColor3", "TextMuted")
        end
    end)

    handle.InputBegan:Connect(function(input)
        if not IsPress(input) or self.Minimized then
            return
        end

        local startPointer = input.Position
        local startSize = main.AbsoluteSize
        local startPosition = main.Position
        local viewport = self.Gui.AbsoluteSize
        local minSize = self.Settings.MinSize
        local maxWidth = viewport.X > 0 and math.max(minSize.X, viewport.X - 20) or math.huge
        local maxHeight = viewport.Y > 0 and math.max(minSize.Y, viewport.Y - main.AbsolutePosition.Y - 10) or math.huge

        BeginDrag(input, function(pointer)
            local delta = pointer - startPointer
            local width = math.clamp(startSize.X - delta.X, minSize.X, maxWidth)
            local height = math.clamp(startSize.Y + delta.Y, minSize.Y, maxHeight)

            -- Main is anchored at the top center, so the center moves half the
            -- width change to keep the right edge in place.
            main.Size = UDim2.fromOffset(width, height)
            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset - (width - startSize.X) / 2,
                startPosition.Y.Scale,
                startPosition.Y.Offset
            )

            self._fullSize = main.Size
        end)
    end)

    self.ResizeHandle = handle
end

function Window:Toggle()
    if self.Loading then
        return
    end

    self:SetVisible(not self.Visible)
end

function Window:SetToggleKey(key)
    if typeof(key) ~= "EnumItem" then
        error("Window:SetToggleKey expects an Enum.KeyCode", 2)
    end

    self.ToggleKey = key
end

function Window:Destroy()
    Library:Unload()
end

-- Creates the window. One window per Library instance.
function Library:CreateWindow(settings)
    if self.Window then
        error("CreateWindow: a window already exists", 2)
    end

    local name = tostring((settings or {}).Title or LIBRARY_NAME)
    local read = ReadSettings("Window", name, WINDOW_SCHEMA, settings, 3)

    -- Validate the folder before anything is built, so a bad name leaves nothing behind.
    if not self.Config:SetFolder(read.ConfigFolder) then
        error("Window: ConfigFolder needs at least one letter or digit", 2)
    end

    local window = Window.new(read)

    self.Window = window
    return window
end


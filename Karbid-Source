        TextSize = Metrics.TextSmall,
        PlaceholderText = "#RRGGBB",
        Text = "",
        Theme = {
            BackgroundColor3 = "Surface",
            TextColor3 = "Text",
            PlaceholderColor3 = "TextMuted",
        },
        Parent = footer,
    }, {
        Corner(6),
        Stroke("Stroke", 1, Metrics.StrokeTransparency),
    })

    svHit.InputBegan:Connect(function(input)
        if IsPress(input) then
            BeginDrag(input, function(pointer)
                self:_FromSV(pointer)
            end, true, page)
        end
    end)

    hueHit.InputBegan:Connect(function(input)
        if IsPress(input) then
            BeginDrag(input, function(pointer)
                self:_FromHue(pointer)
            end, true, page)
        end
    end)

    self.HexBox.FocusLost:Connect(function()
        local color = HexToColor(self.HexBox.Text)

        if color then
            self:SetValue(color)
        else
            self:_Render(self.Value)
        end
    end)

    self.Hit.MouseButton1Click:Connect(function()
        self:ToggleOpen()
    end)

    self:_Render(settings.Default)
    self:_Finish()

    return self
end

function ColorPicker:_PopupHeight()
    return PICKER_HEIGHT
end

function ColorPicker:_Render(color)
    self.Swatch.BackgroundColor3 = color
    self.SV.BackgroundColor3 = Color3.fromHSV(self._h, 1, 1)
    self.SVCursor.Position = UDim2.new(self._s, 0, 1 - self._v, 0)
    self.HueMarker.Position = UDim2.new(0.5, 0, self._h, 0)
    self.HexBox.Text = "#" .. ColorToHex(color)
end

-- Rebuilds the color from the current hue / saturation / value. The callback
-- only runs when the visible color (its hex) actually changes.
function ColorPicker:_Apply(silent)
    local color = Color3.fromHSV(self._h, self._s, self._v)
    local changed = ColorToHex(color) ~= ColorToHex(self.Value)

    self.Value = color
    self:_Render(color)

    if changed then
        Library.OptionChanged:Fire(self.Flag)

        if not silent then
            self:_Call(self.Settings.Callback, color)
        end
    end
end

function ColorPicker:_FromSV(pointer)
    local size = self.SV.AbsoluteSize

    if self.Destroyed or size.X <= 0 or size.Y <= 0 then
        return
    end

    local position = self.SV.AbsolutePosition
    self._s = math.clamp((pointer.X - position.X) / size.X, 0, 1)
    self._v = 1 - math.clamp((pointer.Y - position.Y) / size.Y, 0, 1)
    self:_Apply(false)
end

function ColorPicker:_FromHue(pointer)
    local size = self.Hue.AbsoluteSize

    if self.Destroyed or size.Y <= 0 then
        return
    end

    self._h = math.clamp((pointer.Y - self.Hue.AbsolutePosition.Y) / size.Y, 0, 1)
    self:_Apply(false)
end

function ColorPicker:SetValue(color, silent)
    if typeof(color) ~= "Color3" then
        error("ColorPicker:SetValue expects a Color3", 2)
    end

    local h, s, v = color:ToHSV()

    -- Grey and black have no hue, so keep the one already chosen.
    if s > 0 and v > 0 then
        self._h = h
    end

    self._s, self._v = s, v
    self:_Apply(silent)
end

function ColorPicker:GetValue()
    return self.Value
end

function ColorPicker:GetSaveData()
    return ColorToHex(self.Value)
end

function ColorPicker:LoadSaveData(data)
    local color = type(data) == "string" and HexToColor(data)

    if color then
        self:SetValue(color)
    end
end

function ColorPicker:Destroy()
    self.Window:_PopupClosed(self)
    Element.Destroy(self)
end

